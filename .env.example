# Contact form email delivery. Set these as Railway service variables (not in git).

# Recipient(s) of form submissions (comma-separated). Default: ventas@tekras.com
CONTACT_TO=ventas@tekras.com

# Sender shown on the email. With Resend it must be on a domain verified in Resend.
CONTACT_FROM=Tekras Web <no-reply@tekras.net>

# Option A (recommended on Railway): Resend HTTP API — https://resend.com
RESEND_API_KEY=

# Option B: SMTP (Railway only allows outbound SMTP on the Pro plan)
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=ventas@tekras.com
# SMTP_PASS=
