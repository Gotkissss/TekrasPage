---
import Base from '../../../layouts/Base.astro';
import { services } from '../../../data/site';
import { serviceDetails } from '../../../data/service-details';
import ServiceDetail from '../../../components/ServiceDetail.astro';
import { langParams, useTranslations } from '../../../i18n';

// Every service needs an entry in src/data/service-details.ts.
export function getStaticPaths() {
  return langParams.flatMap(({ lang }) =>
    services.map((service) => ({ params: { lang, slug: service.slug }, props: { service } })),
  );
}

const { service } = Astro.props;
const { lang, t } = useTranslations(Astro.url);
const details = serviceDetails[service.slug];
if (!details) throw new Error(`Missing service details for "${service.slug}"`);
---
<Base title={service.title[lang] + t.service.titleSuffix} description={service.summary[lang]}>
  <ServiceDetail service={service} details={details} />
</Base>
