---
// Old service URLs left over from the Framer template (/services/luna-craft).
// Each one is a tiny page that sends the visitor to the new URL, so old links keep working.
import { langParams, localizePath } from '../../../i18n';

export function getStaticPaths() {
  const moved = { 'luna-craft': 'pentesting' };
  return langParams.flatMap(({ lang }) =>
    Object.entries(moved).map(([old, slug]) => ({ params: { lang, old }, props: { slug } })),
  );
}
const { lang } = Astro.params;
const target = localizePath(`/services/${Astro.props.slug}`, lang === 'en' ? 'en' : 'es');
---
<!doctype html>
<html lang={lang ?? 'es'}>
  <head>
    <meta charset="utf-8" />
    <title>Tekras</title>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(target, Astro.site)} />
  </head>
  <body>
    <a href={target}>{target}</a>
  </body>
</html>
