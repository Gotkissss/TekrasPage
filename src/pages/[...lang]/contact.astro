---
import Base from '../../layouts/Base.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import ProfileCard from '../../components/ProfileCard.astro';
import { site, services } from '../../data/site';
import { langParams, useTranslations } from '../../i18n';

export const getStaticPaths = () => langParams.map((params) => ({ params }));

const { lang, t } = useTranslations(Astro.url);
const c = t.contact;
const f = c.fields;
// Services the visitor can pick: the 4 service pages + extras (mitigation, not sure).
// A service page links here with ?servicio=<slug> to preselect it (see script below).
const serviceOptions = [...services.map((s) => ({ value: s.slug, label: s.title[lang] })), ...c.extraServices];
// Texts the browser script needs (button states, messages)
const messages = {
  submit: c.submit,
  sending: c.sending,
  sent: c.sent,
  success: c.success,
  servicesRequired: c.servicesRequired,
  fallback: `${c.fallback} ${site.email}.`,
};
const icon = {
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/>',
  phone: '<path d="M5 3.5h3.5l1.8 4.5-2.3 1.4a11 11 0 0 0 6.6 6.6l1.4-2.3 4.5 1.8V19a1.5 1.5 0 0 1-1.6 1.5A16.5 16.5 0 0 1 3.5 5.1 1.5 1.5 0 0 1 5 3.5z"/>',
  pin: '<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
  lock: '<rect x="4.5" y="10.5" width="15" height="10.5" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/>',
};
---
<Base title={c.title}>
  <section class="intro">
    <SectionLabel text={c.label} />
    <h1 class="heading">{c.heading}</h1>
    <p class="intro-text">{c.intro}</p>
  </section>

  <section class="cols">
    <!-- Left: who you'll talk to, direct contact, what happens next -->
    <aside class="left">
      <div class="panel">
        <ProfileCard />
      </div>

      <div class="panel">
        <SectionLabel text={c.directLabel} />
        <ul class="contact-list">
          <li>
            <span class="c-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icon.mail} /></span>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <span class="c-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icon.phone} /></span>
            <a href={site.phoneHref}>{site.phone}</a>
          </li>
          <li>
            <span class="c-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icon.pin} /></span>
            <a href={site.office.mapUrl} target="_blank" rel="noopener">{site.office.line1}<br />{site.office.line2}</a>
          </li>
        </ul>
      </div>

      <div class="panel">
        <SectionLabel text={c.nextLabel} />
        <ol class="next">
          {c.next.map((step, i) => (
            <li>
              <span class="next-num">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <p class="confidential">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon.lock} />
        {c.confidential}
      </p>
    </aside>

    <!-- Right: the form -->
    <div class="form-card">
      <h2 class="kick">{c.kickoff}</h2>
      <p class="brief">{c.brief}</p>

      <form id="contact-form" class="form" method="post" action="/api/contact" novalidate data-messages={JSON.stringify(messages)}>
        <input type="hidden" name="lang" value={lang} />

        <div class="row">
          <label class="field">
            <span class="field-label">{f.name.label} <span class="req" aria-hidden="true">*</span></span>
            <input type="text" name="name" placeholder={f.name.placeholder} autocomplete="name" required />
          </label>
          <label class="field">
            <span class="field-label">{f.company.label} <span class="req" aria-hidden="true">*</span></span>
            <input type="text" name="company" placeholder={f.company.placeholder} autocomplete="organization" required />
          </label>
        </div>

        <div class="row">
          <label class="field">
            <span class="field-label">{f.email.label} <span class="req" aria-hidden="true">*</span></span>
            <input type="email" name="email" placeholder={f.email.placeholder} autocomplete="email" required />
          </label>
          <label class="field">
            <span class="field-label">{f.phone.label} <span class="opt">{c.optional}</span></span>
            <input type="tel" name="phone" placeholder={f.phone.placeholder} autocomplete="tel" />
          </label>
        </div>

        <fieldset class="field services">
          <legend class="field-label">{c.servicesLabel} <span class="req" aria-hidden="true">*</span></legend>
          <p class="hint">{c.servicesHint}</p>
          <div class="pills">
            {serviceOptions.map((o) => (
              <label class="pill">
                <input type="checkbox" name="services" value={o.value} />
                <span>{o.label}</span>
              </label>
            ))}
          </div>
          <p class="services-error" role="alert" hidden></p>
        </fieldset>

        <label class="field">
          <span class="field-label">{c.size} <span class="opt">{c.optional}</span></span>
          <span class="select-wrap">
            <select name="size">
              <option value="" selected>{c.select}</option>
              {c.sizes.map((s) => <option value={s}>{s}</option>)}
            </select>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          </span>
        </label>

        <label class="field">
          <span class="field-label">{c.message} <span class="opt">{c.optional}</span></span>
          <textarea name="message" placeholder={c.messagePlaceholder} rows="4"></textarea>
        </label>

        <!-- Honeypots: humans never see or fill these -->
        <div class="hp" aria-hidden="true">
          <input type="text" name="website" tabindex="-1" autocomplete="off" />
          <input type="text" name="fax" tabindex="-1" autocomplete="off" />
        </div>

        <button type="submit" class="btn btn-block swap-host submit">
          <span class="swap"><span data-label>{c.submit}</span><span data-label>{c.submit}</span></span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </button>
        <p class="status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form')!;
  const button = form.querySelector<HTMLButtonElement>('.submit')!;
  const status = form.querySelector<HTMLElement>('.status')!;
  const servicesError = form.querySelector<HTMLElement>('.services-error')!;
  const boxes = [...form.querySelectorAll<HTMLInputElement>('input[name="services"]')];
  const labels = button.querySelectorAll<HTMLElement>('[data-label]');
  const setLabel = (t: string) => labels.forEach((l) => (l.textContent = t));
  const msg: Record<string, string> = JSON.parse(form.dataset.messages!);

  // Preselect the service when coming from a service page (?servicio=<slug>)
  const preset = new URLSearchParams(location.search).get('servicio');
  boxes.forEach((b) => (b.checked = b.value === preset));

  const servicesOk = () => {
    const ok = boxes.some((b) => b.checked);
    servicesError.hidden = ok;
    servicesError.textContent = ok ? '' : msg.servicesRequired;
    return ok;
  };
  boxes.forEach((b) => b.addEventListener('change', () => !servicesError.hidden && servicesOk()));

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    status.textContent = '';
    status.classList.remove('error');
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    if (!servicesOk()) {
      boxes[0].focus();
      return;
    }
    button.disabled = true;
    setLabel(msg.sending);
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || '');
      form.reset();
      setLabel(msg.sent);
      status.textContent = msg.success;
      setTimeout(() => setLabel(msg.submit), 4000);
    } catch (err) {
      setLabel(msg.submit);
      status.classList.add('error');
      status.textContent = [(err as Error).message, msg.fallback].filter(Boolean).join(' ');
    } finally {
      button.disabled = false;
    }
  });
</script>

<style>
  /* ---------- Intro ---------- */
  .intro { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; padding: 30px var(--gutter) 0; }
  .heading { font-weight: 600; font-size: 42px; line-height: 1.1; letter-spacing: -0.02em; }
  .intro-text { max-width: 640px; font-family: var(--font-mono); font-weight: 200; font-size: 17px; line-height: 27px; letter-spacing: -0.02em; color: var(--color-gray); }

  .cols { display: flex; flex-direction: column; gap: 24px; padding: 48px var(--gutter) 0; }

  /* ---------- Left column ---------- */
  .left { display: flex; flex-direction: column; gap: 16px; }
  .panel { padding: 24px; border: 1px solid rgba(27, 27, 27, 0.1); border-radius: 20px; background: rgba(255, 255, 255, 0.3); }
  .panel :global(.profile) { padding-left: 0; }
  .contact-list { display: flex; flex-direction: column; gap: 16px; margin-top: 18px; }
  .contact-list li { display: flex; align-items: flex-start; gap: 14px; font-weight: 600; font-size: 16px; line-height: 22px; letter-spacing: -0.02em; }
  .contact-list a { padding-top: 7px; transition: color 0.2s; }
  .contact-list a:hover { color: var(--color-maroon); }
  .c-icon { display: grid; place-items: center; flex-shrink: 0; width: 36px; height: 36px; border-radius: 10px; background: var(--color-maroon); color: var(--color-cream); }

  .next { display: flex; flex-direction: column; gap: 18px; margin-top: 18px; }
  .next li { display: flex; gap: 14px; }
  .next-num { flex-shrink: 0; width: 36px; font-family: 'Monaspace Xenon', var(--font-mono); font-weight: 600; font-size: 14px; line-height: 22px; color: var(--color-maroon); }
  .next h3 { font-weight: 600; font-size: 16px; line-height: 22px; letter-spacing: -0.02em; }
  .next p { margin-top: 4px; font-family: var(--font-mono); font-weight: 200; font-size: 14px; line-height: 21px; color: var(--color-gray); }

  .confidential { display: flex; align-items: center; gap: 10px; padding: 0 6px; font-family: var(--font-mono); font-weight: 300; font-size: 13px; line-height: 20px; color: var(--color-gray); }
  .confidential svg { flex-shrink: 0; color: var(--color-maroon); }

  /* ---------- Form ---------- */
  .form-card { padding: 28px 22px; border-radius: 24px; background: #fff; box-shadow: 0 30px 60px -40px rgba(92, 45, 50, 0.35); border: 1px solid rgba(27, 27, 27, 0.06); }
  .kick { font-family: var(--font-mono); font-weight: 200; font-size: 24px; line-height: 32px; }
  .brief { margin-top: 6px; font-weight: 500; font-size: 16px; line-height: 24px; letter-spacing: -0.02em; color: var(--color-gray); }

  .form { display: flex; flex-direction: column; gap: 22px; margin-top: 28px; }
  .row { display: grid; grid-template-columns: 1fr; gap: 22px; }
  .field { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .field-label { font-weight: 600; font-size: 14px; line-height: 21px; letter-spacing: -0.01em; }
  .req { color: var(--color-maroon); }
  .opt { font-weight: 400; color: var(--color-muted); }
  .form input:not([type='checkbox']), .form select, .form textarea {
    width: 100%;
    padding: 13px 16px;
    border: 1px solid rgba(27, 27, 27, 0.14);
    border-radius: 12px;
    background: var(--color-cream);
    font: inherit;
    font-size: 16px;
    line-height: 24px;
    color: var(--color-ink);
    transition: border-color 0.2s, box-shadow 0.2s, background-color 0.2s;
  }
  .form input:not([type='checkbox']):hover, .form select:hover, .form textarea:hover { border-color: rgba(92, 45, 50, 0.4); }
  .form input:not([type='checkbox']):focus, .form select:focus, .form textarea:focus {
    outline: none;
    border-color: var(--color-maroon);
    background: #fff;
    box-shadow: 0 0 0 4px rgba(92, 45, 50, 0.12);
  }
  .form ::placeholder { color: var(--color-soft); }
  .form textarea { resize: vertical; min-height: 120px; }
  .select-wrap { position: relative; display: block; }
  .select-wrap select { appearance: none; cursor: pointer; padding-right: 44px; }
  .select-wrap svg { position: absolute; right: 18px; top: 50%; transform: translateY(-50%); color: var(--color-gray); pointer-events: none; }

  /* Service pills (checkboxes) */
  .services { border: 0; padding: 0; margin: 0; }
  .services legend { padding: 0; }
  .hint { margin-top: 2px; font-family: var(--font-mono); font-weight: 300; font-size: 13px; color: var(--color-muted); }
  .pills { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
  .pill { position: relative; cursor: pointer; }
  .pill input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .pill span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px;
    border: 1px solid rgba(27, 27, 27, 0.16);
    border-radius: 999px;
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-gray);
    background: var(--color-cream);
    transition: background-color 0.25s, color 0.25s, border-color 0.25s;
  }
  .pill span::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    transition: background-color 0.25s;
  }
  .pill:hover span { border-color: var(--color-maroon); color: var(--color-maroon); }
  .pill input:checked + span { background: var(--color-maroon); border-color: var(--color-maroon); color: var(--color-cream); }
  .pill input:checked + span::before { background: currentColor; }
  .pill input:focus-visible + span { outline: 2px solid var(--color-maroon); outline-offset: 2px; }
  .services-error { margin-top: 8px; font-size: 13px; color: #9f351b; }

  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .submit { margin-top: 6px; }
  .status { min-height: 21px; font-size: 14px; line-height: 21px; color: var(--color-gray); }
  .status.error { color: #9f351b; }

  /* ---------- Tablet / desktop ---------- */
  @media (min-width: 810px) {
    .intro { padding-top: 60px; }
    .heading { font-size: 64px; }
    .intro-text { font-size: 18px; line-height: 29px; }
    .cols { display: grid; grid-template-columns: 1fr 1.35fr; gap: 24px; align-items: start; padding-top: 64px; }
    .left { position: sticky; top: 24px; }
    .form-card { padding: 40px; }
    .kick { font-size: 28px; line-height: 36px; }
    .row { grid-template-columns: 1fr 1fr; gap: 18px; }
  }
  @media (min-width: 1200px) {
    .heading { font-size: 80px; }
    .cols { grid-template-columns: 1fr 1.6fr; gap: 32px; }
    .form-card { padding: 48px 52px; }
  }
</style>
