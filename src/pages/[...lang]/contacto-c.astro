---
// TEST — contact page option C ("step by step"). Only exists in development (npm run dev).
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import LabForm from '../../components/contact-lab/LabForm.astro';
import LabBar from '../../components/contact-lab/LabBar.astro';
import { site } from '../../data/site';
import { langParams, useTranslations } from '../../i18n';
import '../../styles/contact-lab.css';

export const getStaticPaths = () => (import.meta.env.DEV ? langParams.map((params) => ({ params })) : []);
const { lang, t } = useTranslations(Astro.url);
const c = t.contact;
const { rep: person } = site;
const steps = {
  es: [
    { title: '¿En qué le podemos ayudar?', short: 'Servicio' },
    { title: 'Cuéntenos sobre usted', short: 'Sus datos' },
    { title: 'Su necesidad', short: 'Detalles' },
  ],
  en: [
    { title: 'How can we help?', short: 'Service' },
    { title: 'Tell us about you', short: 'Your details' },
    { title: 'Your needs', short: 'Details' },
  ],
}[lang];
const ui = {
  es: { back: 'Atrás', next: 'Continuar', step: 'Paso', of: 'de', doneTitle: '¡Solicitud enviada!', doneText: 'Un especialista revisará su solicitud y le contactará pronto.' },
  en: { back: 'Back', next: 'Continue', step: 'Step', of: 'of', doneTitle: 'Request sent!', doneText: 'A specialist will review your request and get back to you soon.' },
}[lang];
---
<Base title={`C · ${c.title}`}>
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <span class="eyebrow on-dark">{c.label}</span>
      <h1 class="h-display">{c.heading}</h1>
      <p class="hero-text">{c.intro}</p>
    </div>
  </section>

  <section class="wrap">
    <div class="wizard" data-wizard data-steps={JSON.stringify(steps)} data-ui={JSON.stringify(ui)}>
      <div class="progress">
        <ol class="progress-steps">
          {steps.map((s, i) => <li data-dot={i}><span class="pnum">{i + 1}</span><span class="plabel">{s.short}</span></li>)}
        </ol>
        <div class="bar"><span></span></div>
      </div>

      <p class="step-count" aria-live="polite"></p>
      <h2 class="step-title"></h2>

      <LabForm services="cards" steps size="chips">
        <Fragment slot="before-submit">
          <button type="button" class="btn btn-ghost back" data-back><span>{ui.back}</span></button>
          <button type="button" class="btn btn-primary swap-host next" data-next>
            <span class="swap"><span>{ui.next}</span><span>{ui.next}</span></span>
            <Icon name="arrow" size={16} stroke={1.9} />
          </button>
        </Fragment>
      </LabForm>

      <div class="sent-panel" hidden>
        <span class="sent-icon"><Icon name="check" size={30} stroke={2.4} /></span>
        <h2>{ui.doneTitle}</h2>
        <p>{ui.doneText}</p>
      </div>
    </div>

    <div class="person">
      <img src={person.photo} srcset={person.photoSet} alt={person.name} width="72" height="84" class="person-photo" />
      <div class="person-info">
        <p class="person-name">{person.name}</p>
        <p class="person-role">{person.role[lang]} · Tekras</p>
      </div>
      <ul class="person-links">
        <li><Icon name="mail" size={17} /><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><Icon name="phone" size={17} /><a href={site.phoneHref}>{site.phone}</a></li>
      </ul>
    </div>
    <p class="confidential"><Icon name="lock" size={16} /> {c.confidential}</p>
  </section>
  <LabBar current="c" />
</Base>

<style>
  .hero { position: relative; overflow: hidden; background: var(--color-ink); color: #fff; padding: 56px 0 140px; }
  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(55% 80% at 50% 0%, rgba(110, 47, 56, 0.5), transparent 70%),
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px) 0 0 / 48px 48px,
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px) 0 0 / 48px 48px;
    mask-image: linear-gradient(to bottom, #000 60%, transparent);
  }
  .hero-inner { position: relative; display: flex; flex-direction: column; align-items: center; gap: 18px; text-align: center; }
  .hero-text { max-width: 620px; font-size: 18px; line-height: 1.65; color: #b9bdc7; }

  .wizard { position: relative; max-width: 820px; margin: -100px auto 0; padding: 32px 22px; border: 1px solid var(--color-line); border-radius: 20px; background: #fff; box-shadow: 0 40px 80px -50px rgba(17, 19, 24, 0.45); }
  .progress-steps { display: flex; justify-content: space-between; }
  .progress-steps li { display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 14px; color: var(--color-muted); transition: color 0.3s; }
  .pnum { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; border: 1.5px solid #d9d5cf; font-family: var(--font-mono); font-size: 13px; transition: background-color 0.3s, border-color 0.3s, color 0.3s; }
  .progress-steps li.on { color: var(--color-ink); }
  .progress-steps li.on .pnum { border-color: var(--color-brand); color: var(--color-brand); }
  .progress-steps li.done .pnum { background: var(--color-brand); border-color: var(--color-brand); color: #fff; }
  .bar { height: 4px; margin-top: 16px; border-radius: 4px; background: #efebe6; overflow: hidden; }
  .bar span { display: block; height: 100%; width: 33%; border-radius: inherit; background: var(--color-brand); transition: width 0.5s var(--ease); }

  .step-count { margin-top: 32px; font-family: var(--font-mono); font-weight: 600; font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-brand); }
  .step-title { margin: 6px 0 24px; font-weight: 700; font-size: 28px; letter-spacing: -0.02em; }

  /* only the active step is visible */
  .wizard :global(.group.step) { display: none; }
  .wizard :global(.group.step.active) { display: flex; animation: stepIn 0.45s var(--ease); }
  @keyframes stepIn { from { opacity: 0; transform: translateX(16px); } }
  /* the service question is already the step title */
  .wizard :global(.services legend) { display: none; }
  .back { flex: 0 0 auto; }
  .wizard .next { flex: 1; }

  .sent-panel { display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 40px 0 16px; text-align: center; }
  .sent-panel[hidden] { display: none; }
  .sent-icon { display: grid; place-items: center; width: 64px; height: 64px; border-radius: 50%; background: var(--color-brand); color: #fff; }
  .sent-panel h2 { font-weight: 700; font-size: 28px; }
  .sent-panel p { max-width: 420px; color: var(--color-body); }

  .person { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 20px; max-width: 820px; margin: 20px auto 0; padding: 20px 24px; border: 1px solid var(--color-line); border-radius: 16px; background: var(--color-surface-alt); }
  .person-photo { width: 64px; height: 74px; object-fit: cover; border-radius: 12px; background: #fff; border: 1px solid var(--color-line); }
  .person-info { flex: 1; min-width: 180px; }
  .person-name { font-weight: 600; font-size: 18px; letter-spacing: -0.01em; }
  .person-role { font-size: 14px; color: var(--color-muted); }
  .person-links { display: flex; flex-direction: column; gap: 8px; font-weight: 500; font-size: 15px; }
  .person-links li { display: flex; align-items: center; gap: 10px; }
  .person-links :global(svg) { color: var(--color-brand); }
  .person-links a:hover { color: var(--color-brand); }
  .confidential { display: flex; justify-content: center; align-items: center; gap: 10px; max-width: 820px; margin: 16px auto 120px; font-size: 14px; color: var(--color-muted); }
  .confidential :global(svg) { color: var(--color-brand); }

  @media (max-width: 560px) {
    .plabel { display: none; }
  }
  @media (min-width: 810px) {
    .hero { padding: 88px 0 160px; }
    .wizard { padding: 44px 56px; margin-top: -110px; }
  }
</style>

<script>
  import { initContactForm } from '../../scripts/contact-form';
  const wizard = document.querySelector<HTMLElement>('[data-wizard]')!;
  const form = wizard.querySelector<HTMLFormElement>('[data-lab-form]')!;
  const steps: { title: string }[] = JSON.parse(wizard.dataset.steps!);
  const ui: Record<string, string> = JSON.parse(wizard.dataset.ui!);
  const groups = [...form.querySelectorAll<HTMLElement>('.group.step')];
  const dots = [...wizard.querySelectorAll<HTMLElement>('[data-dot]')];
  const bar = wizard.querySelector<HTMLElement>('.bar span')!;
  const count = wizard.querySelector<HTMLElement>('.step-count')!;
  const title = wizard.querySelector<HTMLElement>('.step-title')!;
  const back = form.querySelector<HTMLButtonElement>('[data-back]')!;
  const next = form.querySelector<HTMLButtonElement>('[data-next]')!;
  const submit = form.querySelector<HTMLButtonElement>('.submit')!;
  const last = groups.length - 1;
  let current = 0;

  // Enter inside an early step moves forward instead of sending (registered before the shared submit handler)
  form.addEventListener('submit', (e) => {
    if (current < last) {
      e.preventDefault();
      e.stopImmediatePropagation();
      go(1);
    }
  });
  const { servicesOk } = initContactForm(form);

  const valid = (i: number) => {
    if (i === 0) return servicesOk();
    const bad = [...groups[i].querySelectorAll<HTMLInputElement>('input, select, textarea')].find((el) => !el.checkValidity());
    if (bad) { bad.reportValidity(); return false; }
    return true;
  };
  const show = (i: number) => {
    current = i;
    groups.forEach((g, k) => g.classList.toggle('active', k === i));
    dots.forEach((d, k) => { d.classList.toggle('on', k === i); d.classList.toggle('done', k < i); });
    bar.style.width = `${((i + 1) / groups.length) * 100}%`;
    count.textContent = `${ui.step} ${i + 1} ${ui.of} ${groups.length}`;
    title.textContent = steps[i].title;
    back.hidden = i === 0;
    next.hidden = i === last;
    submit.hidden = i !== last;
  };
  const go = (dir: number) => {
    if (dir > 0 && !valid(current)) return;
    show(Math.min(last, Math.max(0, current + dir)));
    groups[current].querySelector<HTMLElement>('input:not([type=checkbox]), select, textarea')?.focus({ preventScroll: true });
  };
  next.addEventListener('click', () => go(1));
  back.addEventListener('click', () => go(-1));
  form.addEventListener('sent', () => {
    form.hidden = true;
    wizard.querySelector<HTMLElement>('.sent-panel')!.hidden = false;
    [count, title].forEach((el) => (el.hidden = true));
    dots.forEach((d) => d.classList.add('done'));
    bar.style.width = '100%';
  });
  // ?paso=2 or ?paso=3 opens that step directly (handy while reviewing the design)
  const start = Number(new URLSearchParams(location.search).get('paso')) - 1;
  show(start > 0 && start <= last ? start : 0);
</script>
