---
// "Nosotros / About": story, mission & vision, values, team, and the technology and standards we work with.
import Base from '../../layouts/Base.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import CtaBand from '../../components/CtaBand.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import { langParams, useTranslations } from '../../i18n';
import { standards } from '../../data/site';

export const getStaticPaths = () => langParams.map((params) => ({ params }));

const { lang, t, path } = useTranslations(Astro.url);

const copy = {
  es: {
    title: 'Nosotros - Tekras',
    label: 'Nosotros',
    heading: 'Quiénes Somos',
    intro:
      'Un equipo de ciberseguridad cercano a cada cliente y enfocado en lo que realmente protege su negocio.',
    aboutLabel: 'Nuestra Historia',
    about: [
      t.home.aboutLead + ' ' + t.home.aboutRest,
      'Nacimos con una idea sencilla: la seguridad debe adaptarse al negocio, no al revés. Por eso cada proyecto empieza por entender cómo opera su organización antes de proponer una solución.',
    ],
    purposeLabel: 'Propósito',
    mission: 'Misión',
    missionText:
      'Proteger la continuidad operativa y los activos digitales de las organizaciones mediante seguridad ofensiva y soluciones de acceso seguro, simplificando el acceso a sus sistemas y reduciendo la superficie de ataque en entornos complejos.',
    vision: 'Visión',
    visionText:
      'Ser una consultora de ciberseguridad de referencia a nivel global, convirtiendo infraestructuras complejas y vulnerables en entornos ágiles y protegidos.',
    valuesLabel: 'Valores',
    valuesTitle: 'Lo que guía cada proyecto.',
    values: [
      { title: 'Rigor Técnico', text: 'Garantizar el máximo nivel de especialización y precisión en cada evaluación, implementación y soporte que realizamos.' },
      { title: 'Transparencia', text: 'Hablar con la verdad sobre la postura de riesgo real del cliente y las capacidades operativas, sin falsas promesas tecnológicas.' },
      { title: 'Agilidad', text: 'Eliminar la fricción en la ciberseguridad para asegurar que la protección no paralice ni ralentice el negocio.' },
      { title: 'Proactividad', text: 'Buscar las debilidades antes que los atacantes y actuar antes de que se conviertan en incidentes.' },
    ],
    teamLabel: 'Equipo',
    teamTitle: 'Las personas detrás de Tekras.',
    techLabel: 'Tecnología y estándares',
    techTitle: 'Una base reconocida a nivel mundial en cada proyecto.',
    techText: 'Nos apoyamos en fabricantes y marcos de referencia reconocidos internacionalmente, para que nuestro trabajo sea sólido y verificable.',
    partnerKicker: 'Partner de Appgate',
    partnerText: 'Implementamos Appgate ZTNA y le damos soporte técnico con nuestro propio equipo, para controlar el acceso a toda la infraestructura de su empresa.',
    partnerCta: 'Ver Acceso Seguro (ZTNA)',
    standardsKicker: 'Marcos de referencia',
    standardsText: {
      'OWASP WSTG': 'Guía de pruebas para aplicaciones web.',
      PTES: 'Las fases de un pentest, del acuerdo al informe.',
      'NIST SP 800-115': 'Guía técnica para evaluaciones de seguridad.',
      'MITRE ATT&CK': 'Catálogo de técnicas reales de atacantes.',
    } as Record<string, string>,
  },
  en: {
    title: 'About - Tekras',
    label: 'About',
    heading: 'Who We Are',
    intro: 'A cybersecurity team that stays close to every client and focuses on what truly protects your business.',
    aboutLabel: 'Our Story',
    about: [
      t.home.aboutLead + ' ' + t.home.aboutRest,
      'We started with a simple idea: security should adapt to the business, not the other way around. That’s why every project starts by understanding how your organization operates before we propose a solution.',
    ],
    purposeLabel: 'Purpose',
    mission: 'Mission',
    missionText:
      'To protect the operational continuity and digital assets of organizations through offensive security and secure access solutions, simplifying access to their systems and reducing the attack surface in complex environments.',
    vision: 'Vision',
    visionText:
      'To be a leading cybersecurity consultancy worldwide, turning complex, vulnerable infrastructures into agile, protected environments.',
    valuesLabel: 'Values',
    valuesTitle: 'What guides every project.',
    values: [
      { title: 'Technical Rigor', text: 'Ensuring the highest level of expertise and precision in every assessment, implementation and support engagement we deliver.' },
      { title: 'Transparency', text: 'Telling the truth about each client’s real risk posture and operational capabilities, with no false technology promises.' },
      { title: 'Agility', text: 'Removing friction from cybersecurity so that protection never stalls or slows down the business.' },
      { title: 'Proactivity', text: 'Finding weaknesses before attackers do, and acting before they turn into incidents.' },
    ],
    teamLabel: 'Team',
    teamTitle: 'The people behind Tekras.',
    techLabel: 'Technology & standards',
    techTitle: 'A globally recognized foundation on every project.',
    techText: 'We rely on internationally recognized vendors and frameworks, so our work is solid and verifiable.',
    partnerKicker: 'Appgate partner',
    partnerText: 'We implement Appgate ZTNA and provide technical support with our own team, to control access across your entire infrastructure.',
    partnerCta: 'View Secure Access (ZTNA)',
    standardsKicker: 'Reference frameworks',
    standardsText: {
      'OWASP WSTG': 'Testing guide for web applications.',
      PTES: 'The phases of a pentest, from agreement to report.',
      'NIST SP 800-115': 'Technical guide to security assessments.',
      'MITRE ATT&CK': 'Catalog of real-world attacker techniques.',
    } as Record<string, string>,
  },
}[lang];

// Team. `photo` is the base name in public/images/team/ — there are -240, -480 and -720 versions of each
// (pre-shrunk so the fine pencil lines don't turn into moiré at small sizes).
const team = [
  { name: 'Diego Quixchan', role: lang === 'es' ? 'Líder de Seguridad Ofensiva' : 'Head of Offensive Security', photo: '/images/team/ventas-pentesting' },
  { name: 'Cecilia Amezquita', role: lang === 'es' ? 'Gerente de Ventas' : 'Sales Manager', photo: '/images/team/gerente-ventas' },
  { name: 'Paulo Amezquita', role: lang === 'es' ? 'Ejecutivo de Ventas' : 'Sales Executive', photo: '/images/team/ventas-2' },
] as { name: string; role: string; photo?: string }[];

---
<Base title={copy.title} description={copy.intro}>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <span class="eyebrow on-dark">{copy.label}</span>
      <h1 class="h-display">{copy.heading}</h1>
      <p class="intro">{copy.intro}</p>
    </div>
  </section>

  <!-- About -->
  <section class="block about">
    <div class="about-text">
      <SectionLabel text={copy.aboutLabel} />
      {copy.about.map((p, i) => <p class:list={['reveal', i === 0 ? 'lead' : 'body']}>{p}</p>)}
    </div>
  </section>

  <!-- Mission & Vision -->
  <section class="block">
    <SectionLabel text={copy.purposeLabel} />
    <div class="purpose">
      <article class="purpose-card reveal">
        <span class="purpose-num">01</span>
        <h2>{copy.mission}</h2>
        <p>{copy.missionText}</p>
      </article>
      <article class="purpose-card dark reveal">
        <span class="purpose-num">02</span>
        <h2>{copy.vision}</h2>
        <p>{copy.visionText}</p>
      </article>
    </div>
  </section>

  <!-- Values -->
  <section class="block">
    <div class="block-head">
      <SectionLabel text={copy.valuesLabel} />
      <h2 class="block-title reveal">{copy.valuesTitle}</h2>
    </div>
    <ul class="values">
      {copy.values.map((v, i) => (
        <li class="value reveal" style={`--delay:${i * 100}ms`}>
          <span class="value-num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{v.title}</h3>
          <p>{v.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- Team -->
  <section class="block">
    <div class="block-head">
      <SectionLabel text={copy.teamLabel} />
      <h2 class="block-title reveal">{copy.teamTitle}</h2>
    </div>
    <ul class="team">
      {team.map((m, i) => (
        <li class="member reveal" style={`--delay:${i * 120}ms`}>
          <span class="avatar">
            {m.photo ? <img src={`${m.photo}-480.jpg`} srcset={`${m.photo}-240.jpg 240w, ${m.photo}-480.jpg 480w, ${m.photo}-720.jpg 720w`} sizes="(min-width: 1200px) 240px, 200px" alt={m.name} width="240" height="240" loading="lazy" /> : <span class="initials">{m.name.split(' ').map((w) => w[0]).join('')}</span>}
          </span>
          <h3>{m.name}</h3>
          <p>{m.role}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- Technology & standards -->
  <section class="block">
    <div class="block-head">
      <SectionLabel text={copy.techLabel} />
      <h2 class="block-title reveal">{copy.techTitle}</h2>
      <p class="tech-text reveal">{copy.techText}</p>
    </div>
    <div class="tech">
      <article class="tech-card partner reveal">
        <p class="tech-kicker">{copy.partnerKicker}</p>
        <img src="/partners/appgate.png" alt="Appgate" class="partner-logo" width="600" height="150" loading="lazy" />
        <p class="tech-body">{copy.partnerText}</p>
        <Button href={path('/services/ztna')} variant="ghost">{copy.partnerCta}</Button>
      </article>
      <article class="tech-card reveal" style="--delay:100ms">
        <p class="tech-kicker">{copy.standardsKicker}</p>
        <ul class="standards">
          {standards.map((name) => (
            <li>
              <span class="icon-tile"><Icon name="shieldcheck" /></span>
              <div><h3>{name}</h3><p>{copy.standardsText[name]}</p></div>
            </li>
          ))}
        </ul>
      </article>
    </div>
  </section>

  <CtaBand title={t.home.ctaTitle} text={t.home.ctaText} />
</Base>


<style>
  /* ---------- Shared ---------- */
  .block { max-width: 1312px; margin: 112px auto 0; padding: 0 var(--gutter); }
  .block-head { display: flex; flex-direction: column; gap: 16px; margin-bottom: 44px; }
  .block-title { max-width: 820px; font-weight: 700; font-size: 30px; line-height: 1.15; letter-spacing: -0.03em; }

  /* ---------- Hero ---------- */
  .hero { position: relative; overflow: hidden; background: var(--color-ink); color: #fff; padding: 48px 0 88px; }
  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(55% 80% at 90% 10%, rgba(110, 47, 56, 0.5), transparent 70%),
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px) 0 0 / 48px 48px,
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px) 0 0 / 48px 48px;
    mask-image: linear-gradient(to bottom, #000 60%, transparent);
  }
  .hero-inner { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  .intro { max-width: 720px; font-size: 18px; line-height: 1.65; color: #b9bdc7; }

  /* ---------- About ---------- */
  .about { display: grid; gap: 24px; }
  .about-text { display: flex; flex-direction: column; gap: 22px; max-width: 980px; }
  .lead { font-weight: 400; font-size: 21px; line-height: 1.6; letter-spacing: -0.01em; color: var(--color-body); }
  .body { font-size: 17px; line-height: 1.7; color: var(--color-body); }

  /* ---------- Mission & Vision ---------- */
  .purpose { display: grid; gap: 16px; margin-top: 24px; }
  .purpose-card { display: flex; flex-direction: column; padding: 36px 28px; border: 1px solid var(--color-line); border-radius: var(--radius); background: var(--color-surface-alt); min-height: 280px; }
  .purpose-card.dark { background: var(--color-ink); border-color: var(--color-ink); color: #fff; }
  .purpose-num { font-family: var(--font-mono); font-weight: 600; font-size: 15px; color: var(--color-brand); }
  .purpose-card.dark .purpose-num { color: var(--color-brand-soft); }
  .purpose-card h2 { margin-top: 10px; font-weight: 700; font-size: 36px; line-height: 1.1; letter-spacing: -0.03em; }
  .purpose-card p { margin-top: auto; padding-top: 36px; font-size: 17px; line-height: 1.65; color: var(--color-body); }
  .purpose-card.dark p { color: #c9ccd3; }

  /* ---------- Values ---------- */
  .values { display: grid; gap: 0; border-top: 1px solid var(--color-line); }
  .value { display: flex; flex-direction: column; gap: 12px; padding: 28px 0; border-bottom: 1px solid var(--color-line); }
  .value-num { font-family: var(--font-mono); font-weight: 600; font-size: 15px; color: var(--color-brand); }
  .value h3 { font-weight: 600; font-size: 22px; line-height: 1.2; letter-spacing: -0.02em; transition: color 0.3s; }
  .value p { font-size: 15px; line-height: 1.65; color: var(--color-body); }
  .value:hover h3 { color: var(--color-brand); }

  /* ---------- Team ---------- */
  .team { display: grid; grid-template-columns: 1fr; gap: 20px; }
  .member { display: flex; flex-direction: column; align-items: center; padding: 36px 24px; border: 1px solid var(--color-line); border-radius: var(--radius); background: #fff; text-align: center; transition: border-color 0.3s, box-shadow 0.4s, transform 0.4s var(--ease); }
  .member:hover { border-color: #d9d3cd; box-shadow: 0 24px 48px -30px rgba(17, 19, 24, 0.3); transform: translateY(-4px); }
  .avatar {
    display: grid;
    place-items: center;
    width: 168px;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 0 0 1px var(--color-line), 0 0 0 6px var(--color-surface-alt);
  }
  /* the hand-drawn portraits are the one artistic signature kept from the original brand */
  .avatar img { width: 100%; height: 100%; object-fit: cover; mix-blend-mode: multiply; }
  .initials { font-family: var(--font-mono); font-weight: 600; font-size: 40px; color: var(--color-brand); }
  .member h3 { margin-top: 24px; font-weight: 600; font-size: 19px; letter-spacing: -0.02em; }
  .member p { margin-top: 4px; font-size: 14px; color: var(--color-muted); }

  /* ---------- Technology & standards ---------- */
  .tech-text { max-width: 680px; font-size: 17px; line-height: 1.65; color: var(--color-body); }
  .tech { display: grid; gap: 20px; padding-bottom: 112px; }
  .tech-card { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; padding: 32px 28px; border: 1px solid var(--color-line); border-radius: var(--radius); background: #fff; }
  .tech-card.partner { background: var(--color-surface-alt); }
  .tech-kicker { font-family: var(--font-mono); font-weight: 600; font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-brand); }
  .partner-logo { width: 180px; height: auto; }
  .tech-body { font-size: 17px; line-height: 1.65; color: var(--color-body); }
  .partner :global(.btn) { margin-top: auto; }
  .standards { display: flex; flex-direction: column; width: 100%; }
  .standards li { display: flex; gap: 16px; align-items: center; padding: 14px 0; border-bottom: 1px solid var(--color-line); }
  .standards li:last-child { border-bottom: 0; padding-bottom: 0; }
  .standards h3 { font-family: var(--font-mono); font-weight: 600; font-size: 16px; }
  .standards p { margin-top: 2px; font-size: 15px; line-height: 1.5; color: var(--color-body); }

  /* ---------- Tablet / desktop ---------- */
  @media (min-width: 810px) {
    .block { margin-top: 136px; }
    .block-title { font-size: 40px; }
    .hero { padding: 72px 0 112px; }
    .intro { font-size: 19px; }
    .lead { font-size: 28px; }
    .purpose { grid-template-columns: 1fr 1fr; gap: 20px; }
    .purpose-card { padding: 44px 40px; min-height: 340px; }
    .purpose-card h2 { font-size: 48px; }
    .team { grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .values { grid-template-columns: 1fr 1fr; column-gap: 40px; }
    .tech { grid-template-columns: 1fr 1fr; }
    .tech-card { padding: 40px; }
  }
  @media (min-width: 1200px) {
    .block-title { font-size: 44px; }
    .avatar { width: 200px; }
    .values { grid-template-columns: repeat(4, 1fr); column-gap: 32px; border-bottom: 1px solid var(--color-line); }
    .value { padding: 36px 0 44px; border-bottom: 0; }
  }
</style>
