---
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import ProfileCard from '../../components/ProfileCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site, services, standards } from '../../data/site';
import { langParams, useTranslations } from '../../i18n';

export const getStaticPaths = () => langParams.map((params) => ({ params }));

const { lang, t, path } = useTranslations(Astro.url);
const h = t.home;
// Labels of the small Appgate access diagram
const flow = {
  es: { sub: 'Acceso seguro a la red', user: 'Usuario', apps: 'Aplicaciones', checks: ['Identidad verificada', 'Dispositivo evaluado', 'Solo lo autorizado es visible'] },
  en: { sub: 'Secure network access', user: 'User', apps: 'Applications', checks: ['Verified identity', 'Device posture checked', 'Only what’s authorized is visible'] },
}[lang];
// Labels around the hero radar: the areas the services cover
const radarTags = [
  { text: 'OSINT', x: 16, y: 20 },
  { text: 'WEB', x: 82, y: 16 },
  { text: 'IAM', x: 88, y: 66 },
  { text: 'ZTNA', x: 10, y: 74 },
];
---
<Base title={`Tekras · ${h.heroEyebrow}`} description={h.heroText}>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="eyebrow on-dark">{h.heroEyebrow}</span>
        <h1 class="h-display">{h.heroTitle}</h1>
        <p class="hero-text">{h.heroText}</p>
        <div class="hero-actions">
          <Button href={path('/contact')} variant="light">{t.nav.cta}</Button>
          <Button href="#servicios" variant="ghost-dark" arrow={false}>{h.heroCta2}</Button>
        </div>
      </div>

      <div class="radar" aria-hidden="true">
        <svg viewBox="-100 -100 200 200" class="radar-svg">
          <defs>
            <radialGradient id="rg" r="0.5">
              <stop offset="0" stop-color="#d4848c" stop-opacity="0.18" />
              <stop offset="1" stop-color="#d4848c" stop-opacity="0" />
            </radialGradient>
          </defs>
          <circle r="96" fill="url(#rg)" />
          {[94, 70, 46, 22].map((r) => <circle r={r} class="ring" />)}
          <path d="M-96 0H96M0-96V96" class="axis" />
          <path d="M-68-68 68 68M-68 68 68-68" class="axis faint" />
          <g class="sweep"><path d="M0 0 L0 -94 A94 94 0 0 1 66.5 -66.5 Z" fill="url(#sweep)" /></g>
          <defs>
            <linearGradient id="sweep" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#d4848c" stop-opacity="0" />
              <stop offset="1" stop-color="#d4848c" stop-opacity="0.35" />
            </linearGradient>
          </defs>
          {[[-40, -52], [56, -30], [30, 50], [-60, 34], [-18, 18], [70, 40], [-30, -78]].map(([x, y], i) => (
            <circle cx={x} cy={y} r={i < 2 ? 2.6 : 1.8} class:list={['node', { hot: i < 2 }]} style={`--d:${i * 0.4}s`} />
          ))}
          <image href="/logo-mark.svg" x="-11" y="-11" width="22" height="22" class="core" />
        </svg>
        {radarTags.map((tag) => <span class="radar-tag" style={`left:${tag.x}%;top:${tag.y}%`}>{tag.text}</span>)}
      </div>
    </div>

    <!-- Trust strip -->
    <div class="wrap">
      <div class="trust">
        <p class="trust-label">{h.trustLabel}</p>
        <ul class="trust-list">
          {standards.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section" id="servicios">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">{h.servicesLabel}</span>
        <h2 class="h-section reveal">{h.servicesTitle}</h2>
        <p class="lead reveal">{h.servicesText}</p>
      </div>
      <div class="services">
        {services.map((s, i) => <ServiceCard service={s} delay={i * 80} />)}
      </div>
    </div>
  </section>

  <!-- Pentesting: the core service -->
  <section class="section alt">
    <div class="wrap feature">
      <div class="feature-copy">
        <span class="eyebrow">{h.pentestLabel}</span>
        <h2 class="h-section reveal">{h.pentestTitle}</h2>
        <p class="lead reveal">{h.pentestText}</p>
        <ul class="areas reveal">
          {h.pentestAreas.map((a) => <li><Icon name="check" size={15} stroke={2.2} />{a}</li>)}
        </ul>
        <div class="feature-actions reveal">
          <Button href={path('/services/pentesting')} variant="primary">{h.pentestCta}</Button>
          <Button href={`${path('/contact')}?servicio=pentesting`} variant="ghost" arrow={false}>{t.nav.cta}</Button>
        </div>
      </div>
      <div class="report reveal">
        <p class="report-label"><Icon name="doc" size={16} /> {h.report.label}</p>
        <ol class="report-rows">
          {h.report.rows.map((r, i) => (
            <li>
              <span class="report-num">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{r.title}</h3>
                <p>{r.text}</p>
                {i === 1 && (
                  <ul class="sev">
                    {h.report.severities.map((sv, k) => <li class={`sev-${k}`}>{sv}</li>)}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Technology partner: Appgate ZTNA -->
  <section class="section">
    <div class="wrap appgate">
      <div class="appgate-copy">
        <span class="eyebrow">{h.appgateLabel}</span>
        <h2 class="h-section reveal">{h.appgateTitle}</h2>
        <p class="lead reveal">{h.appgateText}</p>
        <ul class="checks reveal">
          {h.appgatePoints.map((p) => <li><span class="check"><Icon name="check" size={14} stroke={2.4} /></span>{p}</li>)}
        </ul>
        <Button href={path('/services/ztna')} variant="ghost" class="reveal">{h.appgateCta}</Button>
      </div>
      <div class="appgate-card reveal">
        <img src="/partners/appgate.png" alt="Appgate" class="appgate-logo" width="600" height="150" loading="lazy" />
        <p class="appgate-sub">{flow.sub}</p>
        <div class="flow">
          <div class="flow-node"><span class="icon-tile"><Icon name="user" /></span><span>{flow.user}</span></div>
          <span class="flow-line"><span></span></span>
          <div class="flow-node brand"><span class="icon-tile"><Icon name="shieldcheck" /></span><span>Appgate ZTNA</span></div>
          <span class="flow-line"><span></span></span>
          <div class="flow-node"><span class="icon-tile"><Icon name="server" /></span><span>{flow.apps}</span></div>
        </div>
        <ul class="flow-checks">
          <li><Icon name="fingerprint" size={16} /> {flow.checks[0]}</li>
          <li><Icon name="laptop" size={16} /> {flow.checks[1]}</li>
          <li><Icon name="eyeoff" size={16} /> {flow.checks[2]}</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section alt">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">{h.processLabel}</span>
        <h2 class="h-section reveal">{h.processTitle}</h2>
      </div>
      <ol class="process">
        {h.process.map((step, i) => (
          <li class="step reveal" style={`--delay:${i * 90}ms`}>
            <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
      <div class="commit reveal">
        <p class="commit-label">{h.commitmentsLabel}</p>
        <ul class="commit-list">
          {h.commitments.map((c) => (
            <li>
              <span class="icon-tile"><Icon name={c.icon} /></span>
              <div><h3>{c.title}</h3><p>{c.text}</p></div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="section">
    <div class="wrap about">
      <div class="about-copy">
        <span class="eyebrow">{h.aboutLabel}</span>
        <h2 class="h-section reveal">{h.aboutTitle}</h2>
        <p class="lead reveal">{h.aboutLead} {h.aboutRest}</p>
        <p class="about-direct reveal">{h.aboutDirect}</p>
        <Button href={path('/nosotros')} variant="ghost" class="reveal">{h.aboutMore}</Button>
      </div>
      <div class="talk reveal">
        <p class="talk-title">{h.talkTitle}</p>
        <ProfileCard />
        <ul class="talk-list">
          <li><Icon name="mail" size={17} /><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><Icon name="phone" size={17} /><a href={site.phoneHref}>{site.phone}</a></li>
        </ul>
        <Button href={path('/contact')} variant="primary" class="btn-block">{t.nav.cta}</Button>
      </div>
    </div>
  </section>

  <CtaBand title={h.ctaTitle} text={h.ctaText} />
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero { position: relative; overflow: hidden; background: var(--color-ink); color: #fff; padding: 56px 0 0; }
  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 70% at 85% 30%, rgba(110, 47, 56, 0.45), transparent 70%),
      radial-gradient(40% 50% at 10% 100%, rgba(110, 47, 56, 0.25), transparent 70%),
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px) 0 0 / 48px 48px,
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px) 0 0 / 48px 48px;
    mask-image: linear-gradient(to bottom, #000 70%, transparent);
  }
  .hero-grid { position: relative; display: grid; gap: 56px; align-items: center; }
  .hero-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 24px; }
  .hero-text { max-width: 600px; font-size: 18px; line-height: 1.65; color: #b9bdc7; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }

  .radar { position: relative; width: min(100%, 460px); aspect-ratio: 1; margin: 0 auto; }
  .radar-svg { width: 100%; height: 100%; overflow: visible; }
  .ring { fill: none; stroke: rgba(255, 255, 255, 0.12); stroke-width: 0.5; }
  .axis { stroke: rgba(255, 255, 255, 0.08); stroke-width: 0.5; }
  .axis.faint { stroke-dasharray: 2 3; }
  .sweep { transform-origin: 0 0; animation: spin 7s linear infinite; }
  .node { fill: #8b909b; }
  .node.hot { fill: var(--color-brand-soft); animation: blip 2.8s ease-in-out infinite; animation-delay: var(--d); transform-box: fill-box; transform-origin: center; }
  .core { filter: brightness(0) invert(1); opacity: 0.95; }
  .radar-tag { position: absolute; translate: -50% -50%; padding: 4px 9px; border: 1px solid var(--color-line-dark); border-radius: 6px; background: rgba(17, 19, 24, 0.8); font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; color: #c9ccd3; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes blip { 50% { transform: scale(1.8); opacity: 0.55; } }

  .trust { position: relative; display: flex; flex-direction: column; gap: 16px; margin-top: 64px; padding: 28px 0 36px; border-top: 1px solid var(--color-line-dark); }
  .trust-label { font-size: 15px; color: #a3a8b3; }
  .trust-list { display: flex; flex-wrap: wrap; gap: 10px 28px; }
  .trust-list li { font-family: var(--font-mono); font-weight: 600; font-size: 15px; letter-spacing: 0.02em; color: #e3e5e9; }

  /* ---------- Services ---------- */
  .services { display: grid; gap: 16px; }

  /* ---------- Pentesting feature ---------- */
  .feature { display: grid; gap: 48px; align-items: center; }
  .feature-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  .areas { display: grid; grid-template-columns: 1fr; gap: 10px 24px; margin: 4px 0 8px; }
  .areas li { display: flex; align-items: center; gap: 10px; font-weight: 500; font-size: 16px; }
  .areas :global(svg) { flex-shrink: 0; color: var(--color-brand); }
  .feature-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .report { padding: 28px 24px; border: 1px solid var(--color-line); border-radius: 20px; background: #fff; box-shadow: 0 30px 60px -40px rgba(17, 19, 24, 0.35); }
  .report-label { display: flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-weight: 600; font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-muted); }
  .report-label :global(svg) { color: var(--color-brand); }
  .report-rows { display: flex; flex-direction: column; margin-top: 12px; }
  .report-rows > li { display: flex; gap: 16px; padding: 18px 0; border-bottom: 1px solid var(--color-line); }
  .report-rows > li:last-child { border-bottom: 0; padding-bottom: 0; }
  .report-num { flex-shrink: 0; width: 24px; font-family: var(--font-mono); font-size: 14px; line-height: 24px; color: var(--color-brand); }
  .report-rows h3 { font-weight: 600; font-size: 17px; line-height: 24px; }
  .report-rows p { margin-top: 2px; font-size: 15px; line-height: 1.55; color: var(--color-body); }
  .sev { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .sev li { padding: 3px 10px; border-radius: 6px; font-family: var(--font-mono); font-size: 12px; font-weight: 600; }
  .sev-0 { background: #fbe9ea; color: #9b1c2c; }
  .sev-1 { background: #fdf0e4; color: #9a4a0b; }
  .sev-2 { background: #fbf6dd; color: #7a6205; }
  .sev-3 { background: #ebf3ee; color: #2f6b45; }

  /* ---------- Appgate ---------- */
  .appgate { display: grid; gap: 48px; align-items: center; }
  .appgate-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  .checks { display: flex; flex-direction: column; gap: 12px; margin: 4px 0 8px; }
  .checks li { display: flex; align-items: flex-start; gap: 12px; font-size: 16px; line-height: 1.5; color: var(--color-ink); }
  .check { display: grid; place-items: center; flex-shrink: 0; width: 22px; height: 22px; margin-top: 1px; border-radius: 6px; background: var(--color-brand); color: #fff; }
  .appgate-card { padding: 32px 24px; border: 1px solid var(--color-line); border-radius: 20px; background: #fff; box-shadow: 0 30px 60px -40px rgba(17, 19, 24, 0.35); }
  .appgate-logo { width: 150px; height: auto; }
  .appgate-sub { margin-top: 8px; font-family: var(--font-mono); font-weight: 600; font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-muted); }
  .flow { display: flex; align-items: center; gap: 8px; margin-top: 32px; }
  .flow-node { display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center; font-size: 13px; font-weight: 600; color: var(--color-body); }
  .flow-node.brand .icon-tile { background: var(--color-brand); color: #fff; }
  .flow-line { position: relative; flex: 1; height: 2px; margin-bottom: 30px; background: var(--color-line); overflow: hidden; border-radius: 2px; }
  .flow-line span { position: absolute; inset: 0; width: 40%; background: linear-gradient(90deg, transparent, var(--color-brand), transparent); animation: flow 2.4s linear infinite; }
  @keyframes flow { from { transform: translateX(-100%); } to { transform: translateX(250%); } }
  .flow-checks { display: flex; flex-direction: column; gap: 10px; margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--color-line); }
  .flow-checks li { display: flex; align-items: center; gap: 10px; font-size: 14px; color: var(--color-body); }
  .flow-checks :global(svg) { color: var(--color-brand); }

  /* ---------- Process ---------- */
  .process { display: grid; gap: 0; }
  .step { position: relative; padding: 0 0 36px 32px; border-left: 1px solid var(--color-line); }
  .step:last-child { padding-bottom: 0; }
  .step::before { content: ''; position: absolute; left: -5px; top: 4px; width: 9px; height: 9px; border-radius: 2px; background: var(--color-brand); }
  .step-num { font-family: var(--font-mono); font-weight: 600; font-size: 15px; color: var(--color-brand); }
  .step h3 { margin-top: 6px; font-weight: 600; font-size: 20px; letter-spacing: -0.02em; }
  .step p { margin-top: 8px; max-width: 420px; font-size: 15px; line-height: 1.6; color: var(--color-body); }

  /* ---------- Commitments (inside the process section) ---------- */
  .commit { margin-top: 56px; padding: 28px 24px; border: 1px solid var(--color-line); border-radius: 18px; background: #fff; }
  .commit-label { font-family: var(--font-mono); font-weight: 600; font-size: 14px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-brand); }
  .commit-list { display: grid; gap: 20px; margin-top: 20px; }
  .commit-list li { display: flex; gap: 16px; align-items: flex-start; }
  .commit-list h3 { font-weight: 600; font-size: 17px; line-height: 24px; }
  .commit-list p { margin-top: 2px; font-size: 15px; line-height: 1.55; color: var(--color-body); }

  /* ---------- About ---------- */
  .about { display: grid; gap: 48px; align-items: center; }
  .about-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  .about-direct { padding-left: 16px; border-left: 2px solid var(--color-brand); font-size: 16px; line-height: 1.6; color: var(--color-ink); }
  .talk { display: flex; flex-direction: column; gap: 22px; padding: 28px; border: 1px solid var(--color-line); border-radius: 20px; background: #fff; }
  .talk-title { font-family: var(--font-mono); font-weight: 600; font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-muted); }
  .talk-list { display: flex; flex-direction: column; gap: 12px; padding-top: 20px; border-top: 1px solid var(--color-line); }
  .talk-list li { display: flex; align-items: center; gap: 12px; font-weight: 500; font-size: 15px; }
  .talk-list :global(svg) { color: var(--color-brand); }
  .talk-list a:hover { color: var(--color-brand); }

  @media (min-width: 810px) {
    .hero { padding-top: 88px; }
    .hero-text { font-size: 19px; }
    .trust { flex-direction: row; align-items: center; justify-content: space-between; gap: 32px; margin-top: 88px; }
    .trust-label { flex-shrink: 0; }
    .trust-list { justify-content: flex-end; }
    .services { grid-template-columns: 1fr 1fr; gap: 20px; }
    .areas { grid-template-columns: 1fr 1fr; }
    .report { padding: 36px; }
    .commit { padding: 32px 36px; }
    .appgate-card { padding: 40px; }
  }
  @media (min-width: 1200px) {
    .hero-grid { grid-template-columns: 1.15fr 1fr; gap: 64px; }
    .appgate { grid-template-columns: 1fr 1fr; gap: 80px; }
    .about { grid-template-columns: 1.3fr 1fr; gap: 80px; }
    .process { grid-template-columns: repeat(4, 1fr); gap: 32px; }
    .step { padding: 32px 0 0; border-left: 0; border-top: 1px solid var(--color-line); }
    .step::before { left: 0; top: -5px; }
    .feature { grid-template-columns: 1.1fr 1fr; gap: 80px; }
    .commit-list { grid-template-columns: repeat(3, 1fr); gap: 32px; }
  }
</style>
