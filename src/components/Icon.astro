---
// Line icon from src/data/icons.ts.
import { icons } from '../data/icons';
interface Props { name: string; size?: number; stroke?: number; class?: string }
const { name, size = 22, stroke = 1.6, class: className } = Astro.props;
---
<svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[name] ?? icons.shield} />
