---
// "tekras is <word>" hero. Letters of each word fade in one by one, hold, fade out, next word.
import { hero } from '../data/site';
import { getLang } from '../i18n';
const lang = getLang(Astro.url);
const words = hero.words.map((w) => ({ text: w.text[lang], color: w.color }));
const first = words[0];
---
<section class="hero" aria-label="tekras">
  <p class="line">
    <span class="prefix">{hero.prefix[lang]}&nbsp;</span>
    <span class="word" style={`color:${first.color}`} data-words={JSON.stringify(words)} aria-live="off">
      {[...first.text].map((ch) => <span class="ch is-in">{ch}</span>)}
    </span>
  </p>
</section>

<script>
  const LETTER_DELAY = 60; // ms between letters
  const DURATION = 320; // ms per letter transition
  const HOLD = 3500; // ms a full word stays visible

  const el = document.querySelector<HTMLElement>('.hero .word');
  if (el && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const words: { text: string; color: string }[] = JSON.parse(el.dataset.words!);
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const total = (n: number) => DURATION + LETTER_DELAY * (n - 1);

    const render = (text: string, color: string) => {
      el.style.color = color;
      el.replaceChildren(
        ...[...text].map((ch, i) => {
          const s = document.createElement('span');
          s.className = 'ch';
          s.textContent = ch;
          s.style.transitionDelay = `${i * LETTER_DELAY}ms`;
          return s;
        }),
      );
    };
    const setIn = (on: boolean) => el.querySelectorAll('.ch').forEach((c) => c.classList.toggle('is-in', on));

    (async () => {
      let i = 0;
      el.querySelectorAll<HTMLElement>('.ch').forEach((c, n) => (c.style.transitionDelay = `${n * LETTER_DELAY}ms`));
      for (;;) {
        await wait(HOLD);
        el.classList.add('out');
        setIn(false);
        await wait(total(words[i].text.length));
        i = (i + 1) % words.length;
        el.classList.remove('out');
        render(words[i].text, words[i].color);
        el.offsetWidth; // flush styles so the fade-in transition runs
        setIn(true);
        await wait(total(words[i].text.length));
      }
    })();
  }
</script>

<style>
  .hero { display: flex; align-items: center; justify-content: center; height: 330px; padding: 0 var(--gutter); }
  .line { white-space: nowrap; text-align: center; font-size: 22px; line-height: 1; }
  .prefix { font-family: 'Chillax', var(--font-display); font-weight: 500; letter-spacing: -0.01em; color: #000; }
  .word { font-family: 'Monaspace Radon', var(--font-mono); font-style: italic; font-weight: 800; letter-spacing: -0.05em; }
  :global(.hero .ch) {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.25em);
    transition: opacity 320ms cubic-bezier(0.175, 0.885, 0.32, 1.275), transform 320ms cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  :global(.hero .ch.is-in) { opacity: 1; transform: none; }
  :global(.hero .word.out .ch) { transition-timing-function: cubic-bezier(0.55, 0.055, 0.675, 0.19); }
  @media (min-width: 810px) {
    .hero { height: 600px; padding-bottom: 20px; }
    .line { font-size: 40px; }
  }
</style>
