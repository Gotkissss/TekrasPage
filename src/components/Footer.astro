---
// Site footer: brand + CTA on top, four columns (services, company, contact, sales rep), bottom bar.
// Column headings are small uppercase grey labels (not clickable); links are dark and turn maroon + underline on hover.
import ProfileCard from './ProfileCard.astro';
import { site, services } from '../data/site';
import { useTranslations, localizePath, languages, type Lang } from '../i18n';
import { ui } from '../i18n/ui';

const { lang, t, path: to } = useTranslations(Astro.url);
const f = t.footer;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === (to(href).replace(/\/$/, '') || '/');
const company = [
  { href: '/', label: f.about },
  { href: '/contact', label: f.contact },
];
const langs = Object.keys(languages) as Lang[];
const year = new Date().getFullYear();
const icon = {
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/>',
  phone: '<path d="M5 3.5h3.5l1.8 4.5-2.3 1.4a11 11 0 0 0 6.6 6.6l1.4-2.3 4.5 1.8V19a1.5 1.5 0 0 1-1.6 1.5A16.5 16.5 0 0 1 3.5 5.1 1.5 1.5 0 0 1 5 3.5z"/>',
  pin: '<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
};
---
<footer class="footer">
  <div class="card">
    <img src="/logo-mark-large.svg" alt="" class="watermark" aria-hidden="true" loading="lazy" />

    <!-- Brand + call to action -->
    <div class="top">
      <div class="brand">
        <a href={to('/')} aria-label="Tekras"><img src="/logo.svg" alt="tekras" width="148" height="33" class="logo" loading="lazy" /></a>
        <p class="tagline">{f.tagline}</p>
      </div>
      <div class="cta">
        <p class="cta-title">{f.ctaTitle}</p>
        <a href={to('/contact')} class="btn swap-host">
          <span class="swap"><span>{t.nav.cta}</span><span>{t.nav.cta}</span></span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </div>

    <!-- Columns -->
    <div class="cols">
      <nav class="col" aria-label={f.services}>
        <h2 class="heading">{f.services}</h2>
        <ul class="links">
          {services.map((s) => (
            <li><a href={to(`/services/${s.slug}`)} class:list={['link', { active: isActive(`/services/${s.slug}`) }]}>{s.title[lang]}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="col" aria-label={f.company}>
        <h2 class="heading">{f.company}</h2>
        <ul class="links">
          {company.map((l) => (
            <li><a href={to(l.href)} class:list={['link', { active: isActive(l.href) }]}>{l.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="col">
        <h2 class="heading">{f.contactLabel}</h2>
        <ul class="contact">
          <li>
            <span class="c-icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icon.mail} /></span>
            <a href={`mailto:${site.email}`} class="link">{site.email}</a>
          </li>
          <li>
            <span class="c-icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icon.phone} /></span>
            <a href={site.phoneHref} class="link">{site.phone}</a>
          </li>
          <li>
            <span class="c-icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icon.pin} /></span>
            <a href={site.office.mapUrl} target="_blank" rel="noopener" class="link">{site.office.line1}<br />{site.office.line2}</a>
          </li>
        </ul>
      </div>

      <div class="col">
        <h2 class="heading">{f.talk}</h2>
        <div class="rep"><ProfileCard showLink /></div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="bar">
      <p>© {year} Tekras. {f.rights}</p>
      <div class="bar-right">
        <nav class="lang" aria-label="Language / Idioma">
          {langs.map((l, i) => (
            <>
              {i > 0 && <span class="sep" aria-hidden="true">|</span>}
              {l === lang ? <span class="current">{l.toUpperCase()}</span> : <a href={localizePath(Astro.url.pathname, l)} hreflang={l} title={ui[l].nav.switchTo}>{l.toUpperCase()}</a>}
            </>
          ))}
        </nav>
        <a href="#" class="to-top">{f.toTop}</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer { margin-top: 140px; padding: 0 var(--gutter) var(--gutter); }
  .card {
    position: relative;
    overflow: hidden;
    padding: 36px 24px 0;
    border-radius: 28px;
    background: #e9e1d8;
  }
  .watermark {
    position: absolute;
    right: -110px;
    bottom: -150px;
    width: 300px;
    opacity: 0.05;
    pointer-events: none;
  }

  /* ---------- Brand + CTA ---------- */
  .top { position: relative; display: flex; flex-direction: column; gap: 28px; padding-bottom: 36px; border-bottom: 1px solid rgba(27, 27, 27, 0.12); }
  .logo { width: 132px; height: auto; }
  .tagline { margin-top: 14px; max-width: 320px; font-family: var(--font-mono); font-weight: 200; font-size: 15px; line-height: 23px; letter-spacing: -0.02em; color: var(--color-gray); }
  .cta { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
  .cta-title { font-weight: 600; font-size: 22px; line-height: 1.2; letter-spacing: -0.02em; }

  /* ---------- Columns ---------- */
  .cols { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 36px 24px; padding: 36px 0; }
  .col { min-width: 0; }
  .col:nth-child(3), .col:nth-child(4) { grid-column: 1 / -1; }
  /* Headings: small, uppercase, grey — clearly labels, not links */
  .heading {
    font-weight: 600;
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .links { display: flex; flex-direction: column; gap: 12px; margin-top: 18px; }
  /* Links: dark text; hover = maroon + underline sliding in */
  .link {
    position: relative;
    display: inline;
    font-weight: 500;
    font-size: 15px;
    line-height: 22px;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 0 1px;
    transition: color 0.2s, background-size 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .link:hover, .link:focus-visible { color: var(--color-maroon); background-size: 100% 1px; }
  .link.active { color: var(--color-maroon); }

  .contact { display: flex; flex-direction: column; gap: 14px; margin-top: 18px; }
  .contact li { display: flex; align-items: flex-start; gap: 12px; }
  .contact .link { padding-top: 5px; }
  .c-icon { display: grid; place-items: center; flex-shrink: 0; width: 32px; height: 32px; border-radius: 9px; background: var(--color-maroon); color: var(--color-cream); }

  .rep { margin-top: 18px; }
  .rep :global(.profile) { padding-left: 0; gap: 18px; }

  /* ---------- Bottom bar ---------- */
  .bar {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 20px 0 24px;
    border-top: 1px solid rgba(27, 27, 27, 0.12);
    font-family: var(--font-mono);
    font-weight: 300;
    font-size: 13px;
    line-height: 20px;
    color: var(--color-gray);
  }
  .bar-right { display: flex; align-items: center; gap: 24px; }
  .lang { display: flex; align-items: center; gap: 8px; }
  .lang .current { color: var(--color-ink); font-weight: 400; }
  .lang a, .to-top { transition: color 0.2s; }
  .lang a:hover, .to-top:hover { color: var(--color-maroon); }
  .sep { opacity: 0.5; }

  /* ---------- Tablet / desktop ---------- */
  @media (min-width: 810px) {
    .footer { margin-top: 180px; }
    .card { padding: 48px 44px 0; }
    .watermark { width: 440px; right: -190px; bottom: -250px; } /* kept in the corner, away from the photo */
    .top { flex-direction: row; justify-content: space-between; align-items: flex-end; padding-bottom: 44px; }
    .logo { width: 148px; }
    .cta { align-items: flex-end; }
    .cta-title { font-size: 26px; }
    .cols { grid-template-columns: repeat(2, 1fr); gap: 40px 32px; padding: 44px 0; }
    .col:nth-child(3), .col:nth-child(4) { grid-column: auto; }
    .bar { flex-direction: row; justify-content: space-between; align-items: center; }
  }
  @media (min-width: 1200px) {
    .card { padding: 56px 56px 0; }
    .cols { grid-template-columns: 1.15fr 0.8fr 1.1fr 1.1fr; gap: 40px; }
  }
</style>
