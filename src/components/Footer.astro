---
// Site footer (dark): brand, services, company links, contact details and a bottom bar.
import Icon from './Icon.astro';
import { site, services } from '../data/site';
import { showTestPages } from '../data/flags';
import { useTranslations, localizePath, languages, type Lang } from '../i18n';
import { ui } from '../i18n/ui';

const { lang, t, path: to } = useTranslations(Astro.url);
const f = t.footer;
const company = [
  { href: to('/'), label: f.home },
  ...(showTestPages ? [{ href: to('/nosotros'), label: f.about }] : []),
  { href: to('/contact'), label: f.contact },
];
const langs = Object.keys(languages) as Lang[];
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap">
    <div class="grid">
      <div class="brand">
        <a href={to('/')} aria-label="Tekras"><img src="/logo-light.svg" alt="tekras" width="132" height="29" class="logo" loading="lazy" /></a>
        <p class="tagline">{f.tagline}</p>
        <p class="partner"><Icon name="shieldcheck" size={16} /> {t.home.heroNote}</p>
      </div>

      <nav class="col" aria-label={f.services}>
        <h2 class="heading">{f.services}</h2>
        <ul class="links">
          {services.map((s) => <li><a href={to(`/services/${s.slug}`)}>{s.title[lang]}</a></li>)}
        </ul>
      </nav>

      <nav class="col" aria-label={f.company}>
        <h2 class="heading">{f.company}</h2>
        <ul class="links">
          {company.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>

      <div class="col">
        <h2 class="heading">{f.contactLabel}</h2>
        <ul class="contact">
          <li><Icon name="mail" size={17} /><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><Icon name="phone" size={17} /><a href={site.phoneHref}>{site.phone}</a></li>
          <li><Icon name="pin" size={17} /><a href={site.office.mapUrl} target="_blank" rel="noopener">{site.office.line1}<br />{site.office.line2}</a></li>
        </ul>
      </div>
    </div>

    <div class="bar">
      <p>© {year} Tekras. {f.rights}</p>
      <div class="bar-right">
        <nav class="lang" aria-label="Language / Idioma">
          {langs.map((l, i) => (
            <>
              {i > 0 && <span class="sep" aria-hidden="true">/</span>}
              {l === lang ? <span class="current">{l.toUpperCase()}</span> : <a href={localizePath(Astro.url.pathname, l)} hreflang={l} title={ui[l].nav.switchTo}>{l.toUpperCase()}</a>}
            </>
          ))}
        </nav>
        <a href="#" class="to-top">{f.toTop}</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--color-ink); color: #fff; padding-top: 72px; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px 24px; padding-bottom: 56px; }
  .brand { grid-column: 1 / -1; display: flex; flex-direction: column; gap: 16px; }
  .logo { width: 124px; height: auto; }
  .tagline { max-width: 320px; font-size: 15px; line-height: 1.6; color: #a3a8b3; }
  .partner { display: inline-flex; align-items: center; gap: 8px; width: fit-content; padding: 8px 12px; border: 1px solid var(--color-line-dark); border-radius: 8px; font-size: 13px; color: #d5d8de; }
  .partner :global(svg) { color: var(--color-brand-soft); }

  .heading { font-family: var(--font-mono); font-weight: 400; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: #7f8591; }
  .links { display: flex; flex-direction: column; gap: 12px; margin-top: 20px; }
  .links a, .contact a { font-size: 15px; line-height: 1.5; color: #d5d8de; transition: color 0.2s; }
  .links a:hover, .contact a:hover { color: #fff; }
  .col:last-child { grid-column: 1 / -1; }
  .contact { display: flex; flex-direction: column; gap: 14px; margin-top: 20px; }
  .contact li { display: flex; align-items: flex-start; gap: 12px; }
  .contact :global(svg) { flex-shrink: 0; margin-top: 3px; color: var(--color-brand-soft); }

  .bar { display: flex; flex-direction: column; gap: 14px; padding: 24px 0 32px; border-top: 1px solid var(--color-line-dark); font-size: 13px; color: #7f8591; }
  .bar-right { display: flex; align-items: center; gap: 24px; }
  .lang { display: flex; gap: 6px; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em; }
  .lang .current { color: #fff; }
  .lang a, .to-top { transition: color 0.2s; }
  .lang a:hover, .to-top:hover { color: #fff; }
  .sep { opacity: 0.5; }

  @media (min-width: 810px) {
    .footer { padding-top: 96px; }
    .grid { grid-template-columns: 1.6fr 1fr 1fr 1.3fr; gap: 40px; padding-bottom: 72px; }
    .brand, .col:last-child { grid-column: auto; }
    .bar { flex-direction: row; justify-content: space-between; align-items: center; }
  }
</style>
