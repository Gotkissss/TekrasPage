---
// Full service page: dark hero with key facts, scope title beside the overview above a full-width grid, process, deliverables, other services, CTA band.
import Icon from './Icon.astro';
import Button from './Button.astro';
import CtaBand from './CtaBand.astro';
import { site, services, type Service } from '../data/site';
import type { ServiceDetails } from '../data/service-details';
import { useTranslations } from '../i18n';

interface Props { service: Service; details: ServiceDetails }
const { service, details: d } = Astro.props;
const { lang, t, path } = useTranslations(Astro.url);
const s = t.service;
// Per-service section labels, titles and button text (defaults come from ui.ts)
const label = {
  scope: d.labels?.scope?.[lang] ?? s.scope,
  process: d.labels?.process?.[lang] ?? s.process,
  deliverables: d.labels?.deliverables?.[lang] ?? s.deliverables,
};
const button = d.cta.button?.[lang] ?? s.request;
// Buttons open the contact form with this service already selected
const contactHref = `${path('/contact')}?servicio=${service.slug}`;
const title = service.title[lang];
const others = services.filter((x) => x.slug !== service.slug);
---
<!-- Hero -->
<section class="hero">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="wrap hero-inner">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={`${path('/')}#servicios`}>{s.label}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{title}</span>
    </nav>
    <div class="hero-grid">
      <div class="hero-main">
        <span class="icon-tile hero-icon"><Icon name={service.icon} size={28} /></span>
        <h1 class="h-display">{title}</h1>
        <p class="hero-summary">{service.summary[lang]}</p>
        <div class="hero-actions">
          <Button href={contactHref} variant="light">{button}</Button>
          <a href={`mailto:${site.email}`} class="hero-mail"><Icon name="mail" size={17} /> {site.email}</a>
        </div>
      </div>
      <dl class="facts">
        {d.highlights.map((h) => (
          <div class="fact">
            <dt>{h.label[lang]}</dt>
            <dd>{h.value[lang]}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<!-- Overview + scope -->
<section class="section">
  <div class="wrap scope-layout">
    <div class="scope-intro">
      <div class="scope-title">
        <span class="eyebrow">{label.scope}</span>
        <h2 class="h-section reveal">{d.titles.scope[lang]}</h2>
      </div>
      <p class="scope-overview reveal">{d.overview[lang]}</p>
    </div>
    <ul class="scope">
      {d.scope.map((item, n) => (
        <li class="scope-card reveal" style={`--delay:${(n % 3) * 70}ms`}>
          <span class="icon-tile"><Icon name={item.icon} /></span>
          <h3>{item.title[lang]}</h3>
          <p>{item.text[lang]}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- Process -->
<section class="section alt" id="proceso">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{label.process}</span>
      <h2 class="h-section reveal">{d.titles.process[lang]}</h2>
      {d.processText && <p class="lead reveal">{d.processText[lang]}</p>}
    </div>
    <ol class="process" style={`--steps:${d.process.length}`}>
      {d.process.map((step, n) => (
        <li class="step reveal" style={`--delay:${n * 80}ms`}>
          <span class="step-num">{String(n + 1).padStart(2, '0')}</span>
          <h3>{step.title[lang]}</h3>
          <p>{step.text[lang]}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- Deliverables -->
<section class="section">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{label.deliverables}</span>
      <h2 class="h-section reveal">{d.titles.deliverables[lang]}</h2>
    </div>
    <div class="deliverables">
      {d.deliverables.map((x, n) => (
        <article class:list={['deliverable reveal', { dark: n === 1 }]}>
          <span class="icon-tile"><Icon name={n === 0 ? 'doc' : 'file'} /></span>
          <p class="deliverable-eyebrow">{x.eyebrow[lang]}</p>
          <h3>{x.title[lang]}</h3>
          <p class="deliverable-text">{x.text[lang]}</p>
        </article>
      ))}
    </div>
    {d.sample && (
      <div class="sample reveal">
        <a href={d.sample.file[lang]} download class="sample-cover" aria-label={d.sample.button[lang]}>
          <img src={d.sample.cover[lang]} alt="" width="480" height="621" loading="lazy" />
        </a>
        <div class="sample-copy">
          <p class="deliverable-eyebrow">{d.sample.label[lang]}</p>
          <h3>{d.sample.title[lang]}</h3>
          <p class="sample-text">{d.sample.text[lang]}</p>
          <div class="sample-actions">
            <Button href={d.sample.file[lang]} variant="primary" download>{d.sample.button[lang]}</Button>
            <span class="sample-meta">{d.sample.meta[lang]}</span>
          </div>
        </div>
      </div>
    )}
    {d.followUp && (
      <div class="follow-up reveal">
        <div>
          <h3>{d.followUp.title[lang]}</h3>
          <p>{d.followUp.text[lang]}</p>
        </div>
        <Button href={`${path('/contact')}?servicio=${d.followUp.service}`} variant="ghost">{d.followUp.button[lang]}</Button>
      </div>
    )}
    {d.note && <p class="note">{d.note[lang]}</p>}
  </div>
</section>

<!-- Other services -->
<nav class="section alt" aria-label={s.more}>
  <div class="wrap more">
    <span class="eyebrow">{s.more}</span>
    <div class="more-grid">
      {others.map((x) => (
        <a href={path(`/services/${x.slug}`)} class="more-card">
          <span class="icon-tile"><Icon name={x.icon} size={24} /></span>
          <span class="more-copy">
            <span class="more-title">{x.title[lang]}</span>
            <span class="more-summary">{x.summary[lang]}</span>
          </span>
          <Icon name="arrow" size={20} stroke={2} class="more-arrow" />
        </a>
      ))}
    </div>
  </div>
</nav>

<CtaBand title={d.cta.title[lang]} text={d.cta.text[lang]} href={contactHref} button={button} />

<style>
  /* ---------- Hero ---------- */
  .hero { position: relative; overflow: hidden; background: var(--color-ink); color: #fff; padding: 40px 0 64px; }
  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(55% 80% at 90% 10%, rgba(110, 47, 56, 0.5), transparent 70%),
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px) 0 0 / 48px 48px,
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px) 0 0 / 48px 48px;
    mask-image: linear-gradient(to bottom, #000 60%, transparent);
  }
  .hero-inner { position: relative; }
  .crumbs { display: flex; flex-wrap: wrap; gap: 8px; font-family: var(--font-mono); font-size: 14px; letter-spacing: 0.06em; color: #8b909b; }
  .crumbs a { transition: color 0.2s; }
  .crumbs a:hover { color: #fff; }
  .crumbs [aria-current] { color: #d5d8de; }
  .hero-grid { display: grid; gap: 48px; align-items: center; margin-top: 40px; }
  .hero-main { display: flex; flex-direction: column; align-items: flex-start; gap: 22px; }
  .hero-icon { width: 56px; height: 56px; border-radius: 14px; background: rgba(212, 132, 140, 0.14); color: var(--color-brand-soft); }
  .hero-summary { max-width: 680px; font-size: 18px; line-height: 1.65; color: #b9bdc7; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; margin-top: 8px; }
  .hero-mail { display: inline-flex; align-items: center; gap: 10px; font-size: 15px; color: #d5d8de; transition: color 0.2s; }
  .hero-mail:hover { color: #fff; }
  .facts { display: grid; grid-template-columns: 1fr; padding: 8px 24px; border: 1px solid var(--color-line-dark); border-radius: 18px; background: rgba(255, 255, 255, 0.04); }
  .fact { padding: 18px 0; }
  .fact + .fact { border-top: 1px solid var(--color-line-dark); }
  .fact dt { font-family: var(--font-mono); font-weight: 600; font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; color: #8b909b; }
  .fact dd { margin-top: 6px; font-weight: 600; font-size: 17px; line-height: 1.4; color: #fff; }

  /* ---------- Overview + scope ---------- */
  .scope-layout { display: flex; flex-direction: column; gap: 40px; }
  .scope-intro { display: grid; gap: 18px; }
  .scope-title { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
  .scope-overview { font-size: 17px; line-height: 1.65; color: var(--color-body); }
  .scope { display: grid; gap: 16px; }
  .scope-card { padding: 28px; border: 1px solid var(--color-line); border-radius: var(--radius); background: #fff; transition: border-color 0.3s, box-shadow 0.4s, transform 0.4s var(--ease); }
  .scope-card:hover { border-color: #d9d3cd; box-shadow: 0 20px 40px -28px rgba(17, 19, 24, 0.3); transform: translateY(-4px); }
  .scope-card h3 { margin-top: 20px; font-weight: 600; font-size: 18px; line-height: 1.35; letter-spacing: -0.01em; }
  .scope-card p { margin-top: 8px; font-size: 15px; line-height: 1.6; color: var(--color-body); }

  /* ---------- Process ---------- */
  #proceso { scroll-margin-top: 68px; }
  .process { display: grid; gap: 0; }
  .step { position: relative; padding: 0 0 32px 32px; border-left: 1px solid var(--color-line); }
  .step:last-child { padding-bottom: 0; }
  .step::before { content: ''; position: absolute; left: -5px; top: 4px; width: 9px; height: 9px; border-radius: 2px; background: var(--color-brand); }
  .step-num { font-family: var(--font-mono); font-weight: 600; font-size: 15px; color: var(--color-brand); }
  .step h3 { margin-top: 6px; font-weight: 600; font-size: 18px; letter-spacing: -0.01em; }
  .step p { margin-top: 8px; max-width: 440px; font-size: 15px; line-height: 1.6; color: var(--color-body); }

  /* ---------- Deliverables ---------- */
  .deliverables { display: grid; gap: 16px; }
  .deliverable { display: flex; flex-direction: column; padding: 32px; border: 1px solid var(--color-line); border-radius: var(--radius); background: #fff; }
  .deliverable.dark { background: var(--color-ink); border-color: var(--color-ink); color: #fff; }
  .deliverable.dark .icon-tile { background: rgba(212, 132, 140, 0.14); color: var(--color-brand-soft); }
  .deliverable-eyebrow { margin-top: 24px; font-family: var(--font-mono); font-weight: 600; font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-muted); }
  .deliverable.dark .deliverable-eyebrow { color: #8b909b; }
  .deliverable h3 { margin-top: 10px; font-weight: 700; font-size: 26px; line-height: 1.2; letter-spacing: -0.02em; }
  .deliverable-text { margin-top: 14px; font-size: 15px; line-height: 1.65; color: var(--color-body); }
  .deliverable.dark .deliverable-text { color: #b9bdc7; }
  .sample { display: flex; flex-direction: column; gap: 28px; margin-top: 16px; padding: 28px; border: 1px solid var(--color-line); border-radius: var(--radius); background: #fff; }
  .sample-cover { display: block; flex-shrink: 0; width: 170px; border-radius: 8px; overflow: hidden; box-shadow: 0 24px 40px -22px rgba(17, 19, 24, 0.55); transition: transform 0.4s var(--ease); }
  .sample-cover:hover { transform: translateY(-4px); }
  .sample-cover img { display: block; width: 100%; height: auto; }
  .sample-copy .deliverable-eyebrow { margin-top: 0; }
  .sample-copy h3 { margin-top: 10px; font-weight: 700; font-size: 26px; line-height: 1.2; letter-spacing: -0.02em; }
  .sample-text { max-width: 640px; margin-top: 12px; font-size: 15px; line-height: 1.65; color: var(--color-body); }
  .sample-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-top: 22px; }
  .sample-meta { font-family: var(--font-mono); font-size: 13px; color: var(--color-muted); }
  .follow-up { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; margin-top: 16px; padding: 28px 32px; border: 1px solid var(--color-line); border-radius: var(--radius); background: var(--color-surface-alt); }
  .follow-up h3 { font-weight: 600; font-size: 20px; line-height: 1.3; letter-spacing: -0.015em; }
  .follow-up p { margin-top: 6px; max-width: 640px; font-size: 15px; line-height: 1.6; color: var(--color-body); }
  .note { margin-top: 20px; font-size: 14px; color: var(--color-muted); }

  /* ---------- Other services ---------- */
  .more { display: flex; flex-direction: column; gap: 24px; }
  .more-grid { display: grid; gap: 16px; }
  .more-card { display: flex; align-items: center; gap: 20px; padding: 28px; border: 1px solid var(--color-line); border-radius: var(--radius); background: #fff; transition: border-color 0.3s, box-shadow 0.4s; }
  .more-card:hover { border-color: var(--color-brand); box-shadow: 0 20px 40px -28px rgba(17, 19, 24, 0.3); }
  .more-copy { display: flex; flex-direction: column; gap: 6px; flex: 1; min-width: 0; }
  .more-title { font-weight: 600; font-size: 22px; line-height: 1.25; letter-spacing: -0.02em; }
  .more-summary { max-width: 760px; font-size: 15px; line-height: 1.6; color: var(--color-body); }
  .more-card :global(.more-arrow) { flex-shrink: 0; color: var(--color-brand); transition: transform 0.3s var(--spring); }
  .more-card:hover :global(.more-arrow) { transform: translateX(4px); }

  @media (min-width: 810px) {
    .hero { padding: 56px 0 88px; }
    .hero-grid { margin-top: 56px; }
    .hero-summary { font-size: 20px; }
    .facts { grid-template-columns: 1fr 1fr; column-gap: 32px; }
    .fact:nth-child(2) { border-top: 0; }
    .scope { grid-template-columns: 1fr 1fr; gap: 20px; }
    .deliverables { grid-template-columns: 1fr 1fr; gap: 20px; }
    .deliverable { padding: 40px; }
    .sample { flex-direction: row; align-items: center; gap: 44px; margin-top: 20px; padding: 36px 40px; }
    .follow-up { flex-direction: row; align-items: center; justify-content: space-between; gap: 40px; margin-top: 20px; padding: 32px 40px; }
    .follow-up :global(.btn) { flex-shrink: 0; }
    .more-grid { grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); gap: 20px; }
    .more-card { padding: 32px 36px; }
  }
  @media (min-width: 1200px) {
    .hero-grid { grid-template-columns: 1.3fr 1fr; gap: 72px; }
    .facts { grid-template-columns: 1fr; }
    .fact:nth-child(2) { border-top: 1px solid var(--color-line-dark); }
    .scope-layout { gap: 56px; }
    .scope-intro { grid-template-columns: 1fr 1fr; gap: 72px; align-items: end; }
    .scope { grid-template-columns: repeat(3, 1fr); }
    .process { grid-template-columns: repeat(var(--steps), 1fr); gap: 28px; }
    .step { padding: 32px 0 0; border-left: 0; border-top: 1px solid var(--color-line); }
    .step::before { left: 0; top: -5px; }
    .step p { max-width: none; }
  }
</style>
