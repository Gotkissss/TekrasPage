---
// Full service page: hero, overview + highlights, scope grid, process, deliverables, CTA, prev/next.
import SectionLabel from './SectionLabel.astro';
import { site, services, type Service } from '../data/site';
import type { ServiceDetails } from '../data/service-details';
import { useTranslations } from '../i18n';

interface Props { service: Service; details: ServiceDetails }
const { service, details: d } = Astro.props;
const { lang, t, path } = useTranslations(Astro.url);
const s = t.service;
// Per-service section labels, titles and button text (defaults come from ui.ts)
const label = {
  scope: d.labels?.scope?.[lang] ?? s.scope,
  process: d.labels?.process?.[lang] ?? s.process,
  deliverables: d.labels?.deliverables?.[lang] ?? s.deliverables,
};
const button = d.cta.button?.[lang] ?? s.request;
// Buttons open the contact form with this service already selected
const contactHref = `${path('/contact')}?servicio=${service.slug}`;
const title = service.title[lang];
const longestWord = Math.max(...title.split(/\s+/).map((w) => w.length));

const i = services.findIndex((x) => x.slug === service.slug);
const prev = services[(i - 1 + services.length) % services.length];
const next = services[(i + 1) % services.length];

// Simple line icons (24×24, stroke = currentColor)
const icons: Record<string, string> = {
  web: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M7 6.5h.01M10 6.5h.01"/>',
  api: '<path d="M8 7 3 12l5 5M16 7l5 5-5 5M13.5 5l-3 14"/>',
  server: '<rect x="4" y="3" width="16" height="7" rx="1.5"/><rect x="4" y="14" width="16" height="7" rx="1.5"/><path d="M8 6.5h.01M8 17.5h.01"/>',
  network: '<circle cx="12" cy="5" r="2.5"/><circle cx="5" cy="19" r="2.5"/><circle cx="19" cy="19" r="2.5"/><path d="M12 7.5v4M12 11.5 6.5 17M12 11.5l5.5 5.5"/>',
  mobile: '<rect x="7" y="2.5" width="10" height="19" rx="2"/><path d="M11 18.5h2"/>',
  search: '<circle cx="10.5" cy="10.5" r="6.5"/><path d="m20 20-4.8-4.8"/>',
  key: '<circle cx="8" cy="15" r="4.5"/><path d="m11.2 11.8 8.3-8.3M16.5 6.8l2.5 2.5M14.5 8.8l2 2"/>',
  lock: '<rect x="4.5" y="10.5" width="15" height="10.5" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3M12 15v2"/>',
  eyeoff: '<path d="M3 3l18 18M10.6 5.1A10 10 0 0 1 12 5c5 0 8.5 4.5 9.5 7-.4 1-1.2 2.3-2.4 3.5M6.6 6.6C4.6 8 3.2 10 2.5 12c1 2.5 4.5 7 9.5 7 1.8 0 3.4-.6 4.8-1.4M9.9 9.9a3 3 0 0 0 4.2 4.2"/>',
  fingerprint: '<path d="M12 11v3.5c0 2.5-.8 4.8-2.2 6.5M7.5 8.5A5.5 5.5 0 0 1 17.5 11v2.5c0 1.8-.3 3.5-.9 5M4.5 15c.3-1.2.5-2.5.5-4a7 7 0 0 1 11.5-5.4M20.5 11c0 3-.5 5.8-1.5 8.2M13.5 21c.5-1 .9-2.2 1.2-3.4"/>',
  laptop: '<rect x="4.5" y="5" width="15" height="10.5" rx="1.5"/><path d="M2.5 19h19"/>',
  activity: '<path d="M3 12h4l2.5-6 5 12 2.5-6h4"/>',
  alert: '<path d="M12 3.5 21.5 20h-19z"/><path d="M12 10v4.5M12 17.2h.01"/>',
  bolt: '<path d="M13 2.5 5 13.5h6l-1 8 8-11h-6z"/>',
  sliders: '<path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/>',
  file: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/>',
  bug: '<rect x="7" y="7.5" width="10" height="12" rx="5"/><path d="M9 7.5a3 3 0 0 1 6 0M12 11v8.5M3.5 13H7M17 13h3.5M4.5 8.5 7.5 10M19.5 8.5 16.5 10M4.5 18.5 7.5 17M19.5 18.5 16.5 17"/>',
  gear: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/>',
  people: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.8-3.6 3.4-5.5 6.5-5.5s5.7 1.9 6.5 5.5M16 4.8a3.5 3.5 0 0 1 0 6.4M18.5 14.8c1.7.8 2.7 2.5 3 5.2"/>',
};
const arrow = '<path d="M5 12h14M13 6l6 6-6 6"/>';
---
<!-- Hero -->
<section class="hero">
  <div class="hero-copy">
    <SectionLabel text={s.label} />
    <h1 class="hero-title" style={`--chars:${longestWord}`}>{title}</h1>
    <p class="hero-summary">{service.summary[lang]}</p>
    <div class="hero-actions">
      <a href={contactHref} class="btn swap-host">
        <span class="swap"><span>{button}</span><span>{button}</span></span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} />
      </a>
    </div>
  </div>
  <div class="hero-art">
    <img src={service.image} alt={title} width="1365" height="768" />
  </div>
</section>

<!-- Overview + highlights -->
<section class="block overview">
  <SectionLabel text={s.overview} />
  <p class="overview-text t-body-xl reveal">{d.overview[lang]}</p>
  <dl class="highlights reveal">
    {d.highlights.map((h) => (
      <div class="highlight">
        <dt>{h.label[lang]}</dt>
        <dd>{h.value[lang]}</dd>
      </div>
    ))}
  </dl>
</section>

<!-- Scope -->
<section class="block">
  <div class="block-head">
    <SectionLabel text={label.scope} />
    <h2 class="block-title reveal">{d.titles.scope[lang]}</h2>
  </div>
  <ul class="scope">
    {d.scope.map((item) => (
      <li class="scope-card reveal">
        <span class="scope-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons[item.icon] ?? icons.web} />
        </span>
        <h3>{item.title[lang]}</h3>
        <p>{item.text[lang]}</p>
      </li>
    ))}
  </ul>
</section>

<!-- Process -->
<section class="block">
  <div class="block-head">
    <SectionLabel text={label.process} />
    <h2 class="block-title reveal">{d.titles.process[lang]}</h2>
  </div>
  <ol class="process" style={`--steps:${d.process.length}`}>
    {d.process.map((step, n) => (
      <li class="step reveal" style={`--delay:${n * 90}ms`}>
        <span class="step-num">{String(n + 1).padStart(2, '0')}</span>
        <h3>{step.title[lang]}</h3>
        <p>{step.text[lang]}</p>
      </li>
    ))}
  </ol>
</section>

<!-- Deliverables -->
<section class="block">
  <div class="block-head">
    <SectionLabel text={label.deliverables} />
    <h2 class="block-title reveal">{d.titles.deliverables[lang]}</h2>
  </div>
  <div class="deliverables">
    {d.deliverables.map((x, n) => (
      <article class:list={['deliverable reveal', { dark: n === 1 }]}>
        <p class="deliverable-eyebrow">{x.eyebrow[lang]}</p>
        <h3>{x.title[lang]}</h3>
        <p class="deliverable-text">{x.text[lang]}</p>
      </article>
    ))}
  </div>
  {d.note && (
    <p class="deliverables-note reveal">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5" /><path d="M12 11v5.5M12 7.5h.01" /></svg>
      <span>
        {d.note[lang]}
        {d.noteLink && (
          <a href={`${path('/contact')}?servicio=${d.noteLink.service}`} class="note-link">{d.noteLink.label[lang]} →</a>
        )}
      </span>
    </p>
  )}
</section>

<!-- CTA -->
<section class="block">
  <div class="cta reveal">
    <img src="/logo-mark-large.svg" alt="" class="cta-mark" aria-hidden="true" />
    <h2>{d.cta.title[lang]}</h2>
    <p>{d.cta.text[lang]}</p>
    <div class="cta-actions">
      <a href={contactHref} class="btn swap-host">
        <span class="swap"><span>{button}</span><span>{button}</span></span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} />
      </a>
      <span class="cta-mail">{s.writeUs} <a href={`mailto:${site.email}`}>{site.email}</a></span>
    </div>
  </div>
</section>

<!-- Other services -->
<nav class="block more" aria-label={s.more}>
  <SectionLabel text={s.more} />
  <div class="more-grid">
    {[{ x: prev, dir: s.prev, cls: 'prev' }, { x: next, dir: s.next, cls: 'next' }].map(({ x, dir, cls }) => (
      <a href={path(`/services/${x.slug}`)} class:list={['more-card', cls]}>
        <img src={x.image} alt="" loading="lazy" />
        <span class="more-text">
          <span class="more-dir">{cls === 'prev' ? '‹ ' : ''}{dir}{cls === 'next' ? ' ›' : ''}</span>
          <span class="more-title">{x.title[lang]}</span>
        </span>
      </a>
    ))}
  </div>
</nav>

<style>
  /* ---------- Shared ---------- */
  .block { padding: 0 var(--gutter); margin-top: 120px; }
  .block-head { display: flex; flex-direction: column; gap: 18px; margin-bottom: 44px; }
  .block-title {
    max-width: 820px;
    font-family: 'Monaspace Xenon', var(--font-mono);
    font-weight: 600;
    font-size: 24px;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
  /* ---------- Hero ---------- */
  .hero { display: grid; gap: 40px; padding: 30px var(--gutter) 0; align-items: center; }
  .hero-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  .hero-title {
    font-weight: 700;
    font-size: min(64px, calc((100vw - 2 * var(--gutter)) / (var(--chars) * 0.6)));
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .hero-summary { max-width: 520px; font-family: var(--font-mono); font-weight: 200; font-size: 18px; line-height: 28px; letter-spacing: -0.02em; color: var(--color-gray); }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 22px; margin-top: 10px; }
  .hero-art img { width: 100%; height: auto; animation: float 7s ease-in-out infinite; }
  @keyframes float { 50% { transform: translateY(-12px); } }

  /* ---------- Overview ---------- */
  .block.overview { margin-top: 80px; }
  .overview-text { margin-top: 18px; max-width: 1100px; color: var(--color-ink); }
  .highlights { display: grid; grid-template-columns: 1fr 1fr; gap: 28px 20px; margin-top: 56px; }
  .highlight { padding-top: 16px; border-top: 1px solid rgba(27, 27, 27, 0.18); }
  .highlight dt { font-family: var(--font-mono); font-weight: 300; font-size: 13px; line-height: 20px; color: var(--color-muted); }
  .highlight dd { margin-top: 6px; font-weight: 600; font-size: 17px; line-height: 24px; letter-spacing: -0.02em; }

  /* ---------- Scope ---------- */
  .scope { display: grid; grid-template-columns: 1fr; gap: 16px; }
  .scope-card {
    padding: 28px;
    border: 1px solid rgba(27, 27, 27, 0.1);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.35);
    transition: transform 0.5s var(--spring), border-color 0.4s ease, background-color 0.4s ease, box-shadow 0.5s ease;
  }
  .scope-card:hover { transform: translateY(-6px); border-color: rgba(92, 45, 50, 0.45); background: rgba(255, 255, 255, 0.6); box-shadow: 0 18px 36px -18px rgba(92, 45, 50, 0.35); }
  .scope-icon { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 12px; background: var(--color-maroon); color: var(--color-cream); transition: transform 0.5s var(--spring); }
  .scope-card:hover .scope-icon { transform: rotate(-8deg) scale(1.06); }
  .scope-card h3 { margin-top: 22px; font-weight: 600; font-size: 20px; line-height: 26px; letter-spacing: -0.02em; }
  .scope-card p { margin-top: 10px; font-family: var(--font-mono); font-weight: 200; font-size: 15px; line-height: 23px; letter-spacing: -0.02em; color: var(--color-gray); }

  /* ---------- Process ---------- */
  .process { display: grid; grid-template-columns: 1fr; gap: 0; counter-reset: step; }
  .step { position: relative; padding: 0 0 36px 44px; border-left: 1px solid rgba(92, 45, 50, 0.3); margin-left: 8px; transition-delay: var(--delay); }
  .step:last-child { border-left-color: transparent; padding-bottom: 0; }
  .step::before { content: ''; position: absolute; left: -6px; top: 6px; width: 11px; height: 11px; border-radius: 50%; background: var(--color-maroon); box-shadow: 0 0 0 5px var(--color-cream); }
  .step-num { font-family: 'Monaspace Xenon', var(--font-mono); font-weight: 600; font-size: 14px; color: var(--color-maroon); }
  .step h3 { margin-top: 6px; font-weight: 600; font-size: 20px; line-height: 26px; letter-spacing: -0.02em; }
  .step p { margin-top: 8px; max-width: 420px; font-family: var(--font-mono); font-weight: 200; font-size: 15px; line-height: 23px; color: var(--color-gray); }

  /* ---------- Deliverables ---------- */
  .deliverables { display: grid; grid-template-columns: 1fr; gap: 16px; }
  .deliverable { padding: 36px 32px; border-radius: 22px; background: #e9e1d8; transition: transform 0.5s var(--spring); }
  .deliverable:hover { transform: translateY(-6px); }
  .deliverable.dark { background: var(--color-maroon); color: var(--color-cream); }
  .deliverable-eyebrow { font-family: var(--font-mono); font-weight: 300; font-size: 13px; opacity: 0.7; }
  .deliverable h3 { margin-top: 14px; font-weight: 600; font-size: 30px; line-height: 1.1; letter-spacing: -0.03em; }
  .deliverable-text { margin-top: 16px; font-family: var(--font-mono); font-weight: 200; font-size: 16px; line-height: 25px; letter-spacing: -0.02em; opacity: 0.85; }

  .deliverables-note { display: flex; gap: 10px; align-items: flex-start; max-width: 760px; margin-top: 24px; font-family: var(--font-mono); font-weight: 300; font-size: 14px; line-height: 22px; color: var(--color-gray); }
  .deliverables-note svg { flex-shrink: 0; margin-top: 3px; color: var(--color-maroon); }
  .note-link { display: inline-block; margin-left: 6px; color: var(--color-maroon); font-weight: 400; border-bottom: 1px solid currentColor; transition: opacity 0.2s; }
  .note-link:hover { opacity: 0.75; }

  /* ---------- CTA ---------- */
  .cta {
    position: relative;
    overflow: hidden;
    padding: 56px 28px;
    border-radius: 28px;
    background: linear-gradient(135deg, rgb(38, 30, 31), rgb(20, 20, 20));
    color: var(--color-cream);
  }
  .cta-mark { position: absolute; right: -60px; bottom: -70px; width: 280px; opacity: 0.22; pointer-events: none; transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1); }
  .cta:hover .cta-mark { transform: rotate(25deg) scale(1.05); }
  .cta h2 { position: relative; max-width: 640px; font-weight: 600; font-size: 34px; line-height: 1.1; letter-spacing: -0.03em; }
  .cta p { position: relative; max-width: 520px; margin-top: 16px; font-family: var(--font-mono); font-weight: 200; font-size: 16px; line-height: 25px; opacity: 0.8; }
  .cta-actions { position: relative; display: flex; flex-wrap: wrap; align-items: center; gap: 18px 24px; margin-top: 32px; }
  .cta-mail { font-family: var(--font-mono); font-weight: 200; font-size: 14px; opacity: 0.85; }
  .cta-mail a { border-bottom: 1px solid currentColor; }
  .cta-mail a:hover { color: #fff; }

  /* ---------- Other services ---------- */
  .more-grid { display: grid; grid-template-columns: 1fr; gap: 16px; margin-top: 22px; }
  .more-card { display: flex; align-items: center; gap: 18px; padding: 14px 20px 14px 14px; border: 1px solid rgba(27, 27, 27, 0.1); border-radius: 18px; transition: border-color 0.4s ease, background-color 0.4s ease; }
  .more-card:hover { border-color: rgba(92, 45, 50, 0.45); background: rgba(255, 255, 255, 0.45); }
  .more-card img { width: 110px; height: 80px; object-fit: contain; flex-shrink: 0; transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1); }
  .more-card:hover img { transform: scale(1.08); }
  .more-text { display: flex; flex-direction: column; gap: 4px; }
  .more-dir { font-family: var(--font-mono); font-weight: 300; font-size: 13px; color: var(--color-muted); }
  .more-title { font-weight: 600; font-size: 18px; line-height: 24px; letter-spacing: -0.02em; }
  .more-card.next { flex-direction: row-reverse; text-align: right; padding: 14px 14px 14px 20px; }
  .more-card.next .more-text { align-items: flex-end; }

  /* ---------- Tablet ---------- */
  @media (min-width: 810px) {
    .block { margin-top: 160px; }
    .block-title { font-size: 34px; }
    .hero { grid-template-columns: 1.05fr 1fr; gap: 40px; min-height: 560px; padding-top: 20px; }
    .hero-title { font-size: min(110px, calc((min(100vw, 1440px) * 0.5 - 2 * var(--gutter)) / (var(--chars) * 0.6))); }
    .highlights { grid-template-columns: repeat(4, 1fr); }
    .scope { grid-template-columns: repeat(2, 1fr); }
    .deliverables { grid-template-columns: 1fr 1fr; }
    .deliverable { padding: 48px 44px; min-height: 320px; display: flex; flex-direction: column; }
    .deliverable-text { margin-top: auto; padding-top: 40px; }
    .block.overview { margin-top: 90px; }
    .cta { padding: 80px 64px; }
    .cta h2 { font-size: 48px; }
    .cta-mark { width: 420px; right: -80px; bottom: -110px; }
    .more-grid { grid-template-columns: 1fr 1fr; }
  }

  /* ---------- Desktop ---------- */
  @media (min-width: 1200px) {
    .block-title { font-size: 42px; }
    .scope { grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .process { grid-template-columns: repeat(var(--steps), 1fr); gap: 24px; }
    .step { padding: 34px 0 0; margin-left: 0; border-left: 0; border-top: 1px solid rgba(92, 45, 50, 0.3); }
    .step:last-child { border-top-color: rgba(92, 45, 50, 0.3); }
    .step::before { left: 0; top: -6px; }
    .step p { max-width: none; }
    .deliverable h3 { font-size: 40px; }
    .cta h2 { font-size: 56px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-art img { animation: none; }
  }
</style>
