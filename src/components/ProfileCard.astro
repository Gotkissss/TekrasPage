---
// Sales contact: drawn portrait + name + role. The hand-drawn portrait is a deliberate nod to the original brand.
import { site } from '../data/site';
import { useTranslations } from '../i18n';
const { lang } = useTranslations(Astro.url);
const { rep } = site;
---
<div class="profile">
  <img src={rep.photo} srcset={rep.photoSet} alt={rep.name} width="100" height="116" loading="lazy" class="photo" />
  <div class="info">
    <p class="name">{rep.name}</p>
    <p class="role">{rep.role[lang]} · Tekras</p>
  </div>
</div>

<style>
  .profile { display: flex; align-items: center; gap: 18px; }
  /* multiply blends the drawing's white paper into whatever is behind it */
  .photo { width: 72px; height: 84px; object-fit: cover; border-radius: 12px; background: #fff; border: 1px solid var(--color-line); mix-blend-mode: multiply; }
  .name { font-weight: 600; font-size: 18px; letter-spacing: -0.02em; }
  .role { margin-top: 2px; font-size: 14px; color: var(--color-muted); }
</style>
