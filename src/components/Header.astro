---
// Top bar (dark, sticky): logo, main links, language switch and the main call to action.
// On phones the links fold into a menu button.
import Icon from './Icon.astro';
import Button from './Button.astro';
import { useTranslations, localizePath, languages, type Lang } from '../i18n';
import { ui } from '../i18n/ui';
import { showTestPages } from '../data/flags';

const { lang, t, path } = useTranslations(Astro.url);
const langs = Object.keys(languages) as Lang[];
const links = [
  { href: `${path('/')}#servicios`, label: t.nav.services },
  ...(showTestPages ? [{ href: path('/nosotros'), label: t.nav.about }] : []),
  { href: path('/contact'), label: t.nav.contact },
];
---
<header class="header" data-header>
  <div class="bar wrap">
    <a href={path('/')} class="logo" aria-label="Tekras">
      <img src="/logo-light.svg" alt="tekras" width="122" height="27" />
    </a>

    <nav class="nav" id="site-nav" aria-label={t.nav.menu}>
      <ul class="links">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
      <div class="lang" aria-label="Language / Idioma">
        {langs.map((l, i) => (
          <>
            {i > 0 && <span class="sep" aria-hidden="true">/</span>}
            {l === lang ? (
              <span class="current" aria-current="true">{l.toUpperCase()}</span>
            ) : (
              <a href={localizePath(Astro.url.pathname, l)} hreflang={l} lang={l} title={ui[l].nav.switchTo}>{l.toUpperCase()}</a>
            )}
          </>
        ))}
      </div>
      <Button href={path('/contact')} variant="light" small class="nav-cta">{t.nav.cta}</Button>
    </nav>

    <button type="button" class="menu-btn" aria-controls="site-nav" aria-expanded="false" aria-label={t.nav.menu}>
      <Icon name="menu" size={22} class="i-open" />
      <Icon name="close" size={22} class="i-close" />
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const btn = header.querySelector<HTMLButtonElement>('.menu-btn')!;
  const setOpen = (open: boolean) => {
    header.classList.toggle('open', open);
    btn.setAttribute('aria-expanded', String(open));
  };
  btn.addEventListener('click', () => setOpen(!header.classList.contains('open')));
  header.querySelectorAll('.nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  // Slightly stronger background once the page scrolls
  const onScroll = () => header.classList.toggle('scrolled', scrollY > 8);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-ink);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s, background-color 0.3s;
  }
  .header.scrolled { border-bottom-color: var(--color-line-dark); }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 68px; }
  .logo { display: block; flex-shrink: 0; }
  .logo img { width: 112px; height: auto; }

  .nav { display: none; }
  .links a { font-weight: 500; font-size: 15px; color: #c9ccd3; transition: color 0.2s; }
  .links a:hover { color: #fff; }
  .lang { display: flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em; color: #8b909b; }
  .lang .current { color: #fff; }
  .lang a { transition: color 0.2s; }
  .lang a:hover { color: #fff; }
  .sep { opacity: 0.5; }

  .menu-btn { display: grid; place-items: center; width: 42px; height: 42px; margin-right: -8px; border-radius: 10px; color: #fff; cursor: pointer; }
  .menu-btn :global(.i-close) { display: none; }

  /* Phone menu: full-width panel under the bar */
  @media (max-width: 1023px) {
    .header.open .nav {
      display: flex;
      flex-direction: column;
      gap: 24px;
      position: absolute;
      top: 68px;
      left: 0;
      right: 0;
      padding: 24px var(--gutter) 32px;
      background: var(--color-ink);
      border-bottom: 1px solid var(--color-line-dark);
    }
    .header.open .links { display: flex; flex-direction: column; gap: 18px; }
    .header.open .links a { font-size: 18px; }
    .header.open .menu-btn :global(.i-open) { display: none; }
    .header.open .menu-btn :global(.i-close) { display: block; }
    .nav :global(.nav-cta) { align-self: flex-start; }
  }

  @media (min-width: 1024px) {
    .bar { height: 76px; }
    .logo img { width: 122px; }
    .menu-btn { display: none; }
    .nav { display: flex; align-items: center; gap: 36px; }
    .links { display: flex; gap: 32px; }
  }
</style>
