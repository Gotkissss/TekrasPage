---
// Home service card: icon, title, one-line summary, technical tags and a link.
import Icon from './Icon.astro';
import type { Service } from '../data/site';
import { useTranslations } from '../i18n';
interface Props { service: Service; delay?: number }
const { service, delay = 0 } = Astro.props;
const { lang, t, path } = useTranslations(Astro.url);
---
<a href={path(`/services/${service.slug}`)} class="card reveal" style={`--delay:${delay}ms`}>
  <span class="icon-tile"><Icon name={service.icon} size={24} /></span>
  <h3 class="title">{service.title[lang]}</h3>
  <p class="summary">{service.summary[lang]}</p>
  <ul class="tags">
    {service.tags[lang].map((tag) => <li class="tag">{tag}</li>)}
  </ul>
  <span class="more">{t.home.viewDetails} <Icon name="arrow" size={16} stroke={2} /></span>
</a>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 32px 28px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: #fff;
    transition: border-color 0.3s ease, box-shadow 0.4s ease, transform 0.4s var(--ease);
  }
  /* brand line that grows along the top edge on hover */
  .card::before {
    content: '';
    position: absolute;
    left: 28px;
    right: 28px;
    top: -1px;
    height: 2px;
    background: var(--color-brand);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease);
  }
  .card:hover { border-color: #d9d3cd; box-shadow: 0 24px 48px -28px rgba(17, 19, 24, 0.28); transform: translateY(-4px); }
  .card:hover::before { transform: scaleX(1); }
  .title { margin-top: 8px; font-weight: 600; font-size: 22px; line-height: 1.25; letter-spacing: -0.02em; }
  .summary { font-size: 15px; line-height: 1.65; color: var(--color-body); }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .more { display: inline-flex; align-items: center; gap: 8px; margin-top: auto; padding-top: 8px; font-weight: 600; font-size: 15px; color: var(--color-brand); transition: gap 0.3s var(--spring); }
  .card:hover .more { gap: 12px; }
  @media (min-width: 810px) {
    .card { padding: 36px; }
    .card::before { left: 36px; right: 36px; }
  }
</style>
